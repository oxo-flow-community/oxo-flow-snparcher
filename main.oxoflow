# ---------------------------------------------------------------------------
# Joint genotyping (GATK: GenomicsDB -> GenotypeGVCFs; DeepVariant: GLnexus)
# ---------------------------------------------------------------------------

[[rules]]
name = "create_db_mapfile"
description = "Write the GenomicsDB sample-name map from per-sample gVCF paths"
input = []
expand_inputs = [
    { pattern = "results/gvcfs/{sample}.g.vcf.gz", variables = { sample = "config.samples_list" } },
]
when = "config.joint_genotyping_enabled && config.variant_tool == 'gatk'"
output = ["results/genomics_db/mapfile.txt"]
log = "logs/create_db_mapfile.txt"
script = "scripts/write_joint_gvcf_mapfile.py {output[0]} {input}"
tags = ["variant-calling"]

[[rules]]
name = "joint_genomics_db_import"
description = "Import all sample gVCFs into a GenomicsDB workspace (GATK)"
input = [
    "results/genomics_db/mapfile.txt",
    "results/reference/{config.reference_name}.fa.gz",
    "results/reference/{config.reference_name}.fa.gz.fai",
    "results/reference/{config.reference_name}.dict",
]
expand_inputs = [
    { pattern = "results/gvcfs/{sample}.g.vcf.gz", variables = { sample = "config.samples_list" } },
    { pattern = "results/gvcfs/{sample}.g.vcf.gz.tbi", variables = { sample = "config.samples_list" } },
]
when = "config.joint_genotyping_enabled && config.variant_tool == 'gatk' && !config.intervals_enabled"
output = [
    "results/gatk_genomics_db",
    "results/gatk_genomics_db.tar",
]
temp_output = ["results/gatk_genomics_db"]
log = "logs/joint_genomics_db_import.txt"
shell = """
: > {log}
export TILEDB_DISABLE_FILE_LOCKING=1
# Upstream passes the .fai as -L, which GATK 4.x rejects ("does not
# contain Features"). Translate the intent — import every reference
# contig — into a bare contig-name list, which GATK accepts natively.
cut -f1 {input[2]} > results/reference/contigs.list
MERGE_CONTIGS_ARG=$(python scripts/interval_list_tools.py genomicsdb-merge-contigs-arg \\
    --input {input[2]} \\
    --threshold 50 2>> {log})
gatk GenomicsDBImport \
    --java-options '-Xmx7000m' \
    --genomicsdb-shared-posixfs-optimizations true \
    --batch-size 25 \
    --genomicsdb-workspace-path {output[0]} \
    --merge-input-intervals $MERGE_CONTIGS_ARG \
    --reader-threads {threads} \
    -L results/reference/contigs.list \
    --sample-name-map {input[0]} \
    >> {log} 2>&1
tar -cf {output[1]} {output[0]} >> {log} 2>&1
"""
tags = ["variant-calling"]

[rules.resources]
threads = 1

[rules.environment]
conda = "envs/gatk.yaml"

[[rules]]
name = "joint_genotype_gvcfs"
description = "Jointly genotype the cohort from the GenomicsDB workspace (GATK)"
input = [
    "results/gatk_genomics_db.tar",
    "results/reference/{config.reference_name}.fa.gz",
    "results/reference/{config.reference_name}.fa.gz.fai",
    "results/reference/{config.reference_name}.dict",
]
when = "config.joint_genotyping_enabled && config.variant_tool == 'gatk' && !config.intervals_enabled"
output = [
    "results/vcfs/raw.vcf.gz",
    "results/vcfs/raw.vcf.gz.tbi",
]
temp_output = [
    "results/vcfs/raw.vcf.gz",
    "results/vcfs/raw.vcf.gz.tbi",
]
log = "logs/joint_genotype_gvcfs.txt"
shell = """
EXTRACT_DIR=$(mktemp -d .oxo-joint-gvcf.XXXXXX)
trap 'rm -rf "$EXTRACT_DIR"' EXIT
tar -xf {input[0]} -C "$EXTRACT_DIR"
gatk GenotypeGVCFs \
    --java-options '-Xmx7000m' \
    -R {input[1]} \
    --heterozygosity {config.gatk_het_prior} \
    --genomicsdb-shared-posixfs-optimizations true \
    -V gendb://"$EXTRACT_DIR/results/gatk_genomics_db" \
    -O {output[0]} \
    &> {log}
"""
tags = ["variant-calling"]

[rules.resources]
threads = 1

[rules.environment]
conda = "envs/gatk.yaml"

[[rules]]
name = "glnexus_joint"
description = "Jointly genotype DeepVariant gVCFs with GLnexus (DeepVariant branch)"
input = []
expand_inputs = [
    { pattern = "results/gvcfs/{sample}.g.vcf.gz", variables = { sample = "config.samples_list" } },
    { pattern = "results/gvcfs/{sample}.g.vcf.gz.tbi", variables = { sample = "config.samples_list" } },
]
when = "config.joint_genotyping_enabled && config.variant_tool == 'deepvariant'"
output = [
    "results/vcfs/raw.vcf.gz",
    "results/vcfs/raw.vcf.gz.tbi",
]
temp_output = [
    "results/vcfs/raw.vcf.gz",
    "results/vcfs/raw.vcf.gz.tbi",
]
log = "logs/glnexus_joint.txt"
shell = """
glnexus_db="results/vcfs/GLnexus.DB"
rm -rf "$glnexus_db"
trap 'rm -rf "$glnexus_db"' EXIT

glnexus_mem_gbytes=8
if [ "$glnexus_mem_gbytes" -lt 1 ]; then
    glnexus_mem_gbytes=1
fi

glnexus_cli --dir "$glnexus_db" --mem-gbytes "$glnexus_mem_gbytes" \\
    --config DeepVariant --threads {threads} {input} 2> {log} \\
    | bcftools view -Oz -o {output[0]} - 2>> {log}
bcftools index -f -t {output[0]} 2>> {log}
"""
tags = ["variant-calling"]

[rules.resources]
threads = 1

[rules.environment]
conda = "envs/glnexus.yaml"

# ---------------------------------------------------------------------------
# bcftools caller (gated by variant_tool='bcftools')
#
# Port of upstream's checkpoint-based region fan-out (workflow/rules/
# variant_calling/bcftools.smk:13): the bcftools_regions checkpoint reads
# the runtime .fai and enumerates one region per reference contig; the
# engine cannot know the contig list until index_reference has run, so
# bcftools_regions is an output_pattern producer (one marker file per
# contig) and bcftools_call is a deferred consumer instantiated once per
# discovered region. The cohort BAM list is resolved per sample in the
# shell (markdup -> merged -> external priority, mirroring upstream's
# get_final_bam); the declared BAM-dir globs order the calls behind every
# BAM-producing branch via DAG edges.
# ---------------------------------------------------------------------------

[[rules]]
name = "bcftools_regions"
description = "Enumerate reference contigs into per-region markers (bcftools caller, output_pattern producer)"
input = ["results/reference/{config.reference_name}.fa.gz.fai"]
when = "config.variant_tool == 'bcftools'"
output_pattern = "results/vcfs/regions/{region}.txt"
log = "logs/bcftools_regions.txt"
shell = """
: > {log}
mkdir -p results/vcfs/regions
idx=0
while IFS= read -r line; do
    contig=$(printf '%s' "$line" | cut -f1)
    [ -z "$contig" ] && continue
    region=$(printf 'L%06d' "$idx")
    printf '%s\n' "$contig" > "results/vcfs/regions/$region.txt"
    printf '%s\t%s\n' "$region" "$contig"
    idx=$((idx + 1))
done < {input[0]} > results/vcfs/regions/regions.tsv
"""
tags = ["variant-calling"]

[rules.resources]
threads = 1

[rules.environment]
conda = "envs/bcftools.yaml"

[[rules]]
name = "bcftools_call"
description = "Per-region cohort mpileup + call (bcftools caller)"
input = [
    "results/reference/{config.reference_name}.fa.gz.fai",
    "results/vcfs/regions/{region}.txt",
    "results/bams/merged/*.bam",
    "results/bams/markdup/*.bam",
    "results/bams/input/*.bam",
]
when = "config.variant_tool == 'bcftools'"
output = [
    "results/vcfs/regions/{region}.vcf.gz",
    "results/vcfs/regions/{region}.vcf.gz.tbi",
]
temp_output = [
    "results/vcfs/regions/{region}.vcf.gz",
    "results/vcfs/regions/{region}.vcf.gz.tbi",
]
log = "logs/bcftools_call/{region}.txt"
shell = """
: > {log}
CONTIG=$(cat {input[1]})
BAMS=()
for s in $(echo "{config.samples_list}" | tr ',' ' '); do
    if [ -f "results/bams/markdup/$s.bam" ]; then
        BAMS+=("results/bams/markdup/$s.bam")
    elif [ -f "results/bams/merged/$s.bam" ]; then
        BAMS+=("results/bams/merged/$s.bam")
    elif [ -f "results/bams/input/$s.bam" ]; then
        BAMS+=("results/bams/input/$s.bam")
    fi
done
if [ ${#BAMS[@]} -eq 0 ]; then
    echo "no final BAM found for any sample — skipping bcftools_call for region {region}" >> {log}
    exit 0
fi
bcftools mpileup \
    -f results/reference/{config.reference_name}.fa.gz \
    -q {config.bcftools_min_mapq} \
    -Q {config.bcftools_min_baseq} \
    -d {config.bcftools_max_depth} \
    -r "$CONTIG" \
    --threads {threads} \
    -Ou "${BAMS[@]}" 2> {log} \
    | bcftools call \
        -m \
        --ploidy {config.ploidy} \
        --threads {threads} \
        -v \
        -Oz \
        -o {output[0]} - 2>> {log}
bcftools index -t {output[0]} 2>> {log}
"""
tags = ["variant-calling"]

[rules.resources]
threads = 1

[rules.environment]
conda = "envs/bcftools.yaml"

[[rules]]
name = "bcftools_concat_regions"
description = "Concatenate per-region VCFs into the cohort raw VCF (bcftools caller)"
input = ["results/vcfs/regions/*.vcf.gz"]
when = "config.variant_tool == 'bcftools'"
output = [
    "results/vcfs/raw.vcf.gz",
    "results/vcfs/raw.vcf.gz.tbi",
]
temp_output = [
    "results/vcfs/raw.vcf.gz",
    "results/vcfs/raw.vcf.gz.tbi",
]
depends_on = ["bcftools_regions"]
log = "logs/bcftools_concat_regions.txt"
shell = """
bcftools concat -D -a -Ou {input} 2> {log} \
    | bcftools sort -T . -Oz -o {output[0]} 2>> {log}
bcftools index -t {output[0]} 2>> {log}
"""
tags = ["variant-calling"]

[rules.resources]
threads = 1

[rules.environment]
conda = "envs/bcftools.yaml"

# ---------------------------------------------------------------------------
# GATK hard variant filtration (downstream of joint genotyping)
# ---------------------------------------------------------------------------

[[rules]]
name = "variant_filtration"
description = "Apply GATK hard filters (RPRS/FS_SOR/MQ/QUAL) to the joint raw VCF"
input = [
    "results/vcfs/raw.vcf.gz",
    "results/vcfs/raw.vcf.gz.tbi",
    "results/reference/{config.reference_name}.fa.gz",
    "results/reference/{config.reference_name}.fa.gz.fai",
    "results/reference/{config.reference_name}.dict",
]
when = "config.joint_genotyping_enabled && config.generate_filtered_vcf && config.variant_tool == 'gatk'"
output = [
    "results/vcfs/filtered.vcf.gz",
    "results/vcfs/filtered.vcf.gz.tbi",
]
log = "logs/variant_filtration.txt"
shell = """
gatk VariantFiltration \
    -R {input[2]} \
    -V {input[0]} \
    --output {output[0]} \
    --filter-name "RPRS_filter" \
    --filter-expression "(vc.isSNP() && (vc.hasAttribute('ReadPosRankSum') && ReadPosRankSum < -8.0)) || ((vc.isIndel() || vc.isMixed()) && (vc.hasAttribute('ReadPosRankSum') && ReadPosRankSum < -20.0)) || (vc.hasAttribute('QD') && QD < 2.0)" \
    --filter-name "FS_SOR_filter" \
    --filter-expression "(vc.isSNP() && ((vc.hasAttribute('FS') && FS > 60.0) || (vc.hasAttribute('SOR') &&  SOR > 3.0))) || ((vc.isIndel() || vc.isMixed()) && ((vc.hasAttribute('FS') && FS > 200.0) || (vc.hasAttribute('SOR') &&  SOR > 10.0)))" \
    --filter-name "MQ_filter" \
    --filter-expression "vc.isSNP() && ((vc.hasAttribute('MQ') && MQ < 40.0) || (vc.hasAttribute('MQRankSum') && MQRankSum < -12.5))" \
    --filter-name "QUAL_filter" \
    --filter-expression "QUAL < 30.0" \
    --create-output-variant-index false \
    --invalidate-previous-filters true \
    &> {log}
bcftools index -f -t {output[0]} 2>> {log}
"""
tags = ["variant-calling"]

[rules.resources]
threads = 1

[rules.environment]
conda = "envs/gatk.yaml"

# ---------------------------------------------------------------------------
# QC metrics (fastp stats, BAM stats, combined report)
# ---------------------------------------------------------------------------

[[rules]]
name = "collect_fastp_stats"
description = "Aggregate fastp per-unit stats into a per-sample JSON"
input = ["results/fastp/{sample}/{sample}/u1.json"]
when = "(wildcard.input_type == 'fastq' || wildcard.input_type == 'srr')"
output = ["results/qc_metrics/fastp/{sample}.json"]
log = "logs/collect_fastp_stats/{sample}.txt"
script = "scripts/collect_fastp_stats.py {input} {output}"
tags = ["qc"]

[[rules]]
name = "bam_stats"
description = "Compute samtools coverage and flagstat metrics (no-markdup BAM)"
input = ["results/bams/merged/{sample}.bam"]
when = "!config.mark_duplicates && (wildcard.input_type == 'fastq' || wildcard.input_type == 'srr')"
output = [
    "results/qc_metrics/bam/{sample}_coverage.txt",
    "results/qc_metrics/bam/{sample}_flagstat.txt",
]
temp_output = [
    "results/qc_metrics/bam/{sample}_coverage.txt",
    "results/qc_metrics/bam/{sample}_flagstat.txt",
]
log = "logs/bam_stats/{sample}.txt"
shell = """
samtools coverage {input[0]} -o {output[0]}
samtools flagstat -O tsv {input[0]} > {output[1]}
"""
tags = ["qc"]

[rules.environment]
conda = "envs/samtools.yaml"

[[rules]]
name = "bam_stats_markdup"
description = "Compute samtools coverage and flagstat metrics (duplicate-marked BAM)"
input = ["results/bams/markdup/{sample}.bam"]
when = "config.mark_duplicates && (wildcard.input_type == 'fastq' || wildcard.input_type == 'srr')"
output = [
    "results/qc_metrics/bam/{sample}_coverage.txt",
    "results/qc_metrics/bam/{sample}_flagstat.txt",
]
temp_output = [
    "results/qc_metrics/bam/{sample}_coverage.txt",
    "results/qc_metrics/bam/{sample}_flagstat.txt",
]
log = "logs/bam_stats_markdup/{sample}.txt"
shell = """
samtools coverage {input[0]} -o {output[0]}
samtools flagstat -O tsv {input[0]} > {output[1]}
"""
tags = ["qc"]

[rules.environment]
conda = "envs/samtools.yaml"

[[rules]]
name = "bam_stats_external"
description = "Compute samtools coverage and flagstat metrics (staged external BAM)"
input = ["results/bams/input/{sample}.bam"]
when = "wildcard.input_type == 'bam'"
output = [
    "results/qc_metrics/bam/{sample}_coverage.txt",
    "results/qc_metrics/bam/{sample}_flagstat.txt",
]
temp_output = [
    "results/qc_metrics/bam/{sample}_coverage.txt",
    "results/qc_metrics/bam/{sample}_flagstat.txt",
]
log = "logs/bam_stats_external/{sample}.txt"
shell = """
samtools coverage {input[0]} -o {output[0]}
samtools flagstat -O tsv {input[0]} > {output[1]}
"""
tags = ["qc"]

[rules.environment]
conda = "envs/samtools.yaml"

[[rules]]
name = "parse_bam_stats"
description = "Parse samtools coverage/flagstat output into a per-sample JSON"
# gvcf cohorts have no BAM stage, so the coverage/flagstat producers never
# run for them — the consumer must skip too (live-caught on bioinfo-wsx
# 2026-08-27: FileNotFoundError for the gvcf sample's coverage.txt).
when = "wildcard.input_type != 'gvcf'"
input = [
    "results/qc_metrics/bam/{sample}_coverage.txt",
    "results/qc_metrics/bam/{sample}_flagstat.txt",
]
output = ["results/qc_metrics/bam/{sample}.json"]
log = "logs/parse_bam_stats/{sample}.txt"
script = "scripts/parse_bam_stats.py {input} {output}"
tags = ["qc"]

[[rules]]
name = "combine_qc_metrics"
description = "Combine per-sample QC stats into the final TSV report"
input = []
expand_inputs = [
    { pattern = "results/qc_metrics/fastp/{sample}.json", variables = { sample = "config.samples_list" } },
    { pattern = "results/qc_metrics/bam/{sample}.json", variables = { sample = "config.samples_list" } },
]
output = ["results/qc_metrics/qc_report.tsv"]
log = "logs/combine_qc_metrics.txt"
script = "scripts/combine_qc_metrics.py {input} {output}"
tags = ["qc"]

# ---------------------------------------------------------------------------
# Callable sites (mosdepth/clam coverage + genmap mappability)
# ---------------------------------------------------------------------------

[[rules]]
name = "mosdepth"
description = "Compute per-base coverage with mosdepth (no-markdup BAM)"
input = [
    "results/bams/merged/{sample}.bam",
    "results/bams/merged/{sample}.bam.csi",
]
when = "config.callable_sites_enabled && !config.mark_duplicates && (wildcard.input_type == 'fastq' || wildcard.input_type == 'srr')"
output = [
    "results/callable_sites/depths/{sample}.per-base.d4",
    "results/callable_sites/depths/{sample}.mosdepth.summary.txt",
]
temp_output = ["results/callable_sites/depths/{sample}.per-base.d4"]
log = "logs/mosdepth/{sample}.txt"
shell = """
mosdepth --d4 -t {threads} results/callable_sites/depths/{sample} {input[0]} &> {log}
"""
tags = ["callable-sites"]

[rules.resources]
threads = 4

[rules.environment]
conda = "envs/mosdepth.yaml"

[[rules]]
name = "mosdepth_markdup"
description = "Compute per-base coverage with mosdepth (duplicate-marked BAM)"
input = [
    "results/bams/markdup/{sample}.bam",
    "results/bams/markdup/{sample}.bam.csi",
]
when = "config.callable_sites_enabled && config.mark_duplicates && (wildcard.input_type == 'fastq' || wildcard.input_type == 'srr')"
output = [
    "results/callable_sites/depths/{sample}.per-base.d4",
    "results/callable_sites/depths/{sample}.mosdepth.summary.txt",
]
temp_output = ["results/callable_sites/depths/{sample}.per-base.d4"]
log = "logs/mosdepth_markdup/{sample}.txt"
shell = """
mosdepth --d4 -t {threads} results/callable_sites/depths/{sample} {input[0]} &> {log}
"""
tags = ["callable-sites"]

[rules.resources]
threads = 4

[rules.environment]
conda = "envs/mosdepth.yaml"

[[rules]]
name = "mosdepth_external"
description = "Compute per-base coverage with mosdepth (staged external BAM)"
input = [
    "results/bams/input/{sample}.bam",
    "results/bams/input/{sample}.bam.csi",
]
when = "config.callable_sites_enabled && wildcard.input_type == 'bam'"
output = [
    "results/callable_sites/depths/{sample}.per-base.d4",
    "results/callable_sites/depths/{sample}.mosdepth.summary.txt",
]
temp_output = ["results/callable_sites/depths/{sample}.per-base.d4"]
log = "logs/mosdepth_external/{sample}.txt"
shell = """
mosdepth --d4 -t {threads} results/callable_sites/depths/{sample} {input[0]} &> {log}
"""
tags = ["callable-sites"]

[rules.resources]
threads = 4

[rules.environment]
conda = "envs/mosdepth.yaml"

[[rules]]
name = "clam_collect"
description = "Collect per-sample depth data from D4 files into a Zarr store"
input = []
expand_inputs = [
    { pattern = "results/callable_sites/depths/{sample}.per-base.d4", variables = { sample = "config.samples_list" } },
]
when = "config.callable_sites_enabled"
output = ["results/callable_sites/depths.zarr"]
temp_output = ["results/callable_sites/depths.zarr"]
log = "logs/clam_collect.txt"
shell = """
clam collect \
    -o {output[0]} \
    -t {threads} \
    {input} \
    &> {log}
"""
tags = ["callable-sites"]

[rules.resources]
threads = 8

[rules.environment]
conda = "envs/clam.yaml"

[[rules]]
name = "callable_coverage_thresholds"
description = "Calculate cohort-wide coverage thresholds for callable loci"
input = []
expand_inputs = [
    { pattern = "results/callable_sites/depths/{sample}.mosdepth.summary.txt", variables = { sample = "config.samples_list" } },
]
when = "config.callable_sites_enabled"
output = ["results/callable_sites/coverage_thresholds.tsv"]
log = "logs/callable_coverage_thresholds.txt"
script = "scripts/callable_coverage_thresholds.py --min-coverage {config.callable_sites_min_coverage} --max-coverage {config.callable_sites_max_coverage} --output {output[0]} {input}"
tags = ["callable-sites"]

[rules.environment]
conda = "envs/callable_sites.yaml"

[[rules]]
name = "clam_loci"
description = "Identify callable loci based on coverage"
input = [
    "results/callable_sites/depths.zarr",
    "results/callable_sites/coverage_thresholds.tsv",
]
when = "config.callable_sites_enabled"
output = ["results/callable_sites/callable_loci.zarr"]
temp_output = ["results/callable_sites/callable_loci.zarr"]
log = "logs/clam_loci.txt"
shell = """
min_depth=$(awk -F '\t' 'NR==2 {print $2}' {input[1]})
max_depth=$(awk -F '\t' 'NR==2 {print $3}' {input[1]})
clam loci \
    -o {output[0]} \
    -t {threads} \
    --per-sample \
    -m "$min_depth" \
    -M "$max_depth" \
    {input[0]} \
    &> {log}
"""
tags = ["callable-sites"]

[rules.resources]
threads = 8

[rules.environment]
conda = "envs/clam.yaml"

[[rules]]
name = "coverage_bed"
description = "Create BED of callable regions based on coverage"
input = ["results/callable_sites/callable_loci.zarr"]
when = "config.callable_sites_enabled"
output = ["results/callable_sites/coverage.bed"]
log = "logs/coverage_bed.txt"
script = "scripts/callable_zarr_to_bed.py {input[0]} {output[0]} --fraction {config.callable_sites_fraction} --merge-distance {config.callable_sites_merge_distance}"
tags = ["callable-sites"]

[rules.environment]
conda = "envs/callable_sites.yaml"

[[rules]]
name = "genmap_index"
description = "Create genmap index for mappability calculation"
input = ["results/reference/{config.reference_name}.fa.gz"]
when = "config.callable_sites_enabled"
output = ["results/callable_sites/genmap_index"]
log = "logs/genmap_index.txt"
shell = """
set -euo pipefail

REF_FASTA="results/callable_sites/reference.decompressed.fa"
trap 'rm -f "$REF_FASTA"' EXIT

gunzip -c "{input[0]}" > "$REF_FASTA"
SIZE_BYTES=$(wc -c < "$REF_FASTA" | tr -d '[:space:]')

: > "{log}"
echo "Decompressed FASTA size (bytes): $SIZE_BYTES" >> "{log}"

if (( SIZE_BYTES > 5368709120 )); then
    # >= 5 GB: skew index mode (upstream GENMAP_SKEW_THRESHOLD_BYTES)
    echo "GenMap index mode: skew (-A skew)" >> "{log}"
    genmap index -F "$REF_FASTA" -I "{output[0]}" -A skew >> "{log}" 2>&1
elif (( SIZE_BYTES > 2147483648 )); then
    # >= 2 GB: sampled index mode (upstream GENMAP_SAMPLING_THRESHOLD_BYTES, value 20)
    echo "GenMap index mode: sampled (-S 20)" >> "{log}"
    genmap index -F "$REF_FASTA" -I "{output[0]}" -S 20 >> "{log}" 2>&1
else
    echo "GenMap index mode: default (divsufsort)" >> "{log}"
    genmap index -F "$REF_FASTA" -I "{output[0]}" >> "{log}" 2>&1
fi
"""
tags = ["callable-sites"]

[rules.environment]
conda = "envs/genmap.yaml"

[[rules]]
name = "genmap_mappability"
description = "Compute mappability scores with genmap"
input = ["results/callable_sites/genmap_index"]
when = "config.callable_sites_enabled"
output = ["results/callable_sites/mappability.bedgraph"]
log = "logs/genmap_mappability.txt"
shell = """
genmap map \
    -K {config.callable_sites_kmer} \
    -E 2 \
    -I {input[0]} \
    -O results/callable_sites/mappability \
    -bg \
    -T {threads} \
    &> {log}
"""
tags = ["callable-sites"]

[rules.resources]
threads = 4

[rules.environment]
conda = "envs/genmap.yaml"

[[rules]]
name = "mappability_bed"
description = "Create BED of high-mappability regions"
input = ["results/callable_sites/mappability.bedgraph"]
when = "config.callable_sites_enabled"
output = ["results/callable_sites/mappability.bed"]
log = "logs/mappability_bed.txt"
shell = """
awk -v min={config.callable_sites_min_score} '$4 >= min {print $1"\\t"$2"\\t"$3}' {input[0]} 2> {log} \
    | bedtools sort -i - 2>> {log} \
    | bedtools merge -d {config.callable_sites_merge_distance} -i - > {output[0]} 2>> {log}
"""
tags = ["callable-sites"]

[rules.environment]
conda = "envs/bedtools.yaml"

[[rules]]
name = "callable_sites_bed"
description = "Combine coverage and mappability BEDs into the final callable-sites BED"
input = [
    "results/callable_sites/coverage.bed",
    "results/callable_sites/mappability.bed",
]
when = "config.callable_sites_enabled"
output = ["results/callable_sites/callable_sites.bed"]
log = "logs/callable_sites_bed.txt"
shell = """
cat {input[0]} {input[1]} 2> {log} \
    | bedtools sort -i - 2>> {log} \
    | bedtools merge -i - > {output[0]} 2>> {log}
"""
tags = ["callable-sites"]

[rules.environment]
conda = "envs/bedtools.yaml"

# ---------------------------------------------------------------------------
# Postprocess module (filtered / clean-SNP / clean-indel VCFs)
# Consumes the joint raw VCF (results/vcfs/raw.vcf.gz). Upstream consumes
# FINAL_VCF (hard-filtered for GATK when generate_filtered_vcf=true); see
# README fidelity table.
# ---------------------------------------------------------------------------

[[rules]]
name = "postprocess_filter_individuals"
description = "Write the list of samples to include in downstream filtering"
input = []
when = "config.modules_postprocess_enabled && config.callable_sites_enabled"
output = ["results/postprocess/include_samples.txt"]
log = "logs/postprocess/filter_individuals.txt"
script = "scripts/write_include_samples.py {output[0]} {config.samples_list}"
tags = ["postprocess"]

[[rules]]
name = "postprocess_basic_filter"
description = "Remove excluded individuals, sites failing filters, ref=N, alt=., and AF==0"
input = [
    "results/vcfs/raw.vcf.gz",
    "results/postprocess/include_samples.txt",
]
when = "config.modules_postprocess_enabled && config.callable_sites_enabled"
output = [
    "results/postprocess/basic.vcf.gz",
    "results/postprocess/basic.vcf.gz.tbi",
]
temp_output = [
    "results/postprocess/basic.vcf.gz",
    "results/postprocess/basic.vcf.gz.tbi",
]
shell = """
bcftools view -S {input[1]} -f .,PASS {input[0]} -a -U -O u \\
    | bcftools +fill-tags -Ou \\
    | bcftools view -m2 -e 'AF==0 | ref="N" | ALT="."' -O z -o {output[0]}
bcftools index -f -t {output[0]}
"""
tags = ["postprocess"]

[rules.environment]
conda = "envs/postprocess_filter.yaml"

[[rules]]
name = "postprocess_update_bed"
description = "Refine callable-sites BED: remove regions on contigs smaller than the configured threshold"
input = [
    "results/callable_sites/callable_sites.bed",
    "results/reference/{config.reference_name}.fa.gz.fai",
]
when = "config.modules_postprocess_enabled && config.callable_sites_enabled"
output = [
    "results/postprocess/callable_sites_filtered.bed",
    "results/postprocess/small_contigs.bed",
]
temp_output = ["results/postprocess/small_contigs.bed"]
log = "logs/postprocess/update_bed.txt"
shell = """
awk 'BEGIN{OFS="\\t"}{if ($2<{config.postprocess_contig_size}) {print $1,0,$2}}' \\
    {input[1]} > {output[1]}
bedtools subtract -a {input[0]} -b {output[1]} \\
    | bedtools sort -i - \\
    | bedtools merge -i - > {output[0]}
"""
tags = ["postprocess"]

[rules.environment]
conda = "envs/postprocess_bed.yaml"

[[rules]]
name = "postprocess_strict_filter"
description = "Apply missingness, MAF, and scaffold-exclusion filters, restricted to callable regions"
input = [
    "results/postprocess/callable_sites_filtered.bed",
    "results/postprocess/basic.vcf.gz",
    "results/postprocess/basic.vcf.gz.tbi",
]
when = "config.modules_postprocess_enabled && config.callable_sites_enabled"
output = [
    "results/postprocess/filtered.vcf.gz",
    "results/postprocess/filtered.vcf.gz.tbi",
]
log = "logs/postprocess/strict_filter.txt"
shell = """
UPPER_BOUND=$(awk -v m="{config.postprocess_maf}" 'BEGIN { printf "%.6g", 1-m }')
if [ -z "{config.postprocess_exclude_scaffolds}" ]
then
    bcftools view -R {input[0]} -m2 -M2 \\
        -e "F_MISSING > {config.postprocess_missingness} | AF<{config.postprocess_maf} | AF>$UPPER_BOUND" \\
        {input[1]} -O z -o {output[0]}
else
    bcftools view -t ^{config.postprocess_exclude_scaffolds} -R {input[0]} -m2 -M2 \\
        -e "F_MISSING > {config.postprocess_missingness} | AF<{config.postprocess_maf} | AF>$UPPER_BOUND" \\
        {input[1]} -O z -o {output[0]}
fi
bcftools index -f -t {output[0]}
"""
tags = ["postprocess"]

[rules.environment]
conda = "envs/postprocess_filter.yaml"

[[rules]]
name = "postprocess_subset_indels"
description = "Extract clean indels from the strictly-filtered VCF"
input = [
    "results/postprocess/filtered.vcf.gz",
    "results/postprocess/filtered.vcf.gz.tbi",
]
when = "config.modules_postprocess_enabled && config.callable_sites_enabled"
output = [
    "results/postprocess/clean_indels.vcf.gz",
    "results/postprocess/clean_indels.vcf.gz.tbi",
]
log = "logs/postprocess/subset_indels.txt"
shell = """
bcftools view -v indels -O z -o {output[0]} {input[0]}
bcftools index -f -t {output[0]}
"""
tags = ["postprocess"]

[rules.environment]
conda = "envs/postprocess_filter.yaml"

[[rules]]
name = "postprocess_subset_snps"
description = "Extract SNPs (excluding indel-overlapping sites) from the strictly-filtered VCF"
input = [
    "results/postprocess/filtered.vcf.gz",
    "results/postprocess/filtered.vcf.gz.tbi",
]
when = "config.modules_postprocess_enabled && config.callable_sites_enabled"
output = [
    "results/postprocess/clean_snps_prefilter.vcf.gz",
    "results/postprocess/clean_snps_prefilter.vcf.gz.tbi",
]
temp_output = [
    "results/postprocess/clean_snps_prefilter.vcf.gz",
    "results/postprocess/clean_snps_prefilter.vcf.gz.tbi",
]
log = "logs/postprocess/subset_snps.txt"
shell = """
bcftools view -v snps -e 'TYPE ~ "indel"' -O z -o {output[0]} {input[0]}
bcftools index -f -t {output[0]}
"""
tags = ["postprocess"]

[rules.environment]
conda = "envs/postprocess_filter.yaml"

[[rules]]
name = "postprocess_drop_indel_snps"
description = "Remove SNPs that overlap indels (genotype length > 1)"
input = [
    "results/postprocess/clean_snps_prefilter.vcf.gz",
    "results/postprocess/clean_snps_prefilter.vcf.gz.tbi",
]
when = "config.modules_postprocess_enabled && config.callable_sites_enabled"
output = [
    "results/postprocess/keep_snp_positions.txt",
    "results/postprocess/clean_snps.vcf.gz",
    "results/postprocess/clean_snps.vcf.gz.tbi",
]
temp_output = ["results/postprocess/keep_snp_positions.txt"]
log = "logs/postprocess/drop_indel_snps.txt"
shell = """
bcftools query -f '%CHROM\\t%POS\\t%REF\\t%ALT\\n' {input[0]} \\
    | awk 'length($3) == 1 {print $1"\\t"$2}' \\
    | bgzip -c > {output[0]}
tabix -s1 -b2 -e2 {output[0]}
bcftools view -T {output[0]} {input[0]} -Oz -o {output[1]}
bcftools index -f -t {output[1]}
"""
tags = ["postprocess"]

[rules.environment]
conda = "envs/postprocess_filter.yaml"

# ---------------------------------------------------------------------------
# QC module (PCA, admixture, NJ tree, relatedness dashboard)
# Consumes the joint raw VCF (results/vcfs/raw.vcf.gz). Upstream consumes
# FINAL_VCF; see README fidelity table.
# ---------------------------------------------------------------------------

[[rules]]
name = "qc_contig_map"
description = "Generate a QC-local contig map for PLINK and ADMIXTURE"
input = ["results/reference/{config.reference_name}.fa.gz.fai"]
when = "config.modules_qc_enabled"
output = ["results/qc/contig_map.tsv"]
log = "logs/qc/contig_map.txt"
script = "scripts/contig_map.py {input[0]} {output[0]}"
tags = ["qc-module"]

[[rules]]
name = "qc_vcftools_individuals"
description = "Compute per-individual depth, missingness, het, and filter summary"
input = ["results/vcfs/raw.vcf.gz"]
when = "config.modules_qc_enabled"
output = [
    "results/qc/individuals.idepth",
    "results/qc/individuals.imiss",
    "results/qc/individuals.samps.txt",
    "results/qc/individuals.FILTER.summary",
    "results/qc/individuals.het",
]
log = "logs/qc/vcftools_individuals.txt"
script = "scripts/vcftools_individuals.py {input[0]} results/qc/individuals {config.qc_min_depth} {log} {output[0]} {output[1]} {output[2]} {output[3]} {output[4]}"
tags = ["qc-module"]

[rules.environment]
conda = "envs/qc_vcftools.yaml"

[[rules]]
name = "qc_subsample_snps"
description = "Filter VCF to biallelic SNPs, remove low-quality sites, then prune to ~100k SNPs"
input = [
    "results/vcfs/raw.vcf.gz",
    "results/qc/individuals.samps.txt",
    "results/reference/{config.reference_name}.fa.gz.fai",
]
when = "config.modules_qc_enabled"
output = [
    "results/qc/filtered.vcf.gz",
    "results/qc/pruned.vcf.gz",
    "results/qc/snpqc.txt",
]
temp_output = ["results/qc/filtered.vcf.gz"]
log = "logs/qc/subsample_snps.txt"
shell = """
## Remove filtered sites, retain only biallelic SNPs
## Also remove MAF < 0.01, >75% missing, indels, ref=N
if [ -z "{config.qc_exclude_scaffolds}" ]
then
    bcftools view -S {input[1]} -v snps -m2 -M2 -f .,PASS \\
        -e 'AF==1 | AF==0 | AF<0.01 | ALT="*" | F_MISSING > 0.75 | TYPE~"indel" | ref="N"' \\
        {input[0]} -O z -o {output[0]} &> {log}
else
    bcftools view -S {input[1]} -t ^{config.qc_exclude_scaffolds} -v snps -m2 -M2 -f .,PASS \\
        -e 'AF==1 | AF==0 | AF<0.01 | ALT="*" | F_MISSING > 0.75 | TYPE~"indel" | ref="N"' \\
        {input[0]} -O z -o {output[0]} &> {log}
fi
bcftools index {output[0]} >> {log} 2>&1

# Figure out window size to get ~100k SNPs
ALLSITES=$(bcftools query -f '%CHROM\\t%POS\\n' {output[0]} | wc -l)
SITES=$(( ALLSITES / 100000 ))

# If < 150k SNPs, take all; otherwise prune
if [[ $SITES -gt 1 ]]
then
    bcftools +prune -w $SITES -n 1 -N rand -O z -o {output[1]} {output[0]} >> {log} 2>&1
else
    bcftools view -O z -o {output[1]} {output[0]} >> {log} 2>&1
fi

bcftools query --allow-undef-tags -f '%CHROM\\t%POS\\t%ID\\t%INFO/AF\\t%QUAL\\t%INFO/ReadPosRankSum\\t%INFO/FS\\t%INFO/SOR\\t%INFO/MQ\\t%INFO/MQRankSum\\n' \\
    {output[1]} > {output[2]} 2>> {log}
"""
tags = ["qc-module"]

[rules.environment]
conda = "envs/qc_subsample.yaml"

[[rules]]
name = "qc_prepare_plink_inputs"
description = "Normalize QC-local contig labels for PLINK and copy the matching FAI"
input = [
    "results/qc/pruned.vcf.gz",
    "results/qc/contig_map.tsv",
    "results/reference/{config.reference_name}.fa.gz.fai",
]
when = "config.modules_qc_enabled"
output = [
    "results/qc/plink_input.vcf.gz",
    "results/qc/plink_input.vcf.gz.csi",
    "results/qc/ref.fai",
]
log = "logs/qc/prepare_plink_inputs.txt"
script = "scripts/prepare_plink_inputs.py {input[0]} {input[1]} {input[2]} {output[0]} {output[2]} {log}"
tags = ["qc-module"]

[rules.environment]
conda = "envs/qc_subsample.yaml"

[[rules]]
name = "qc_copy_qc_report"
description = "Copy the BAM summary stats TSV into the QC folder for the dashboard"
input = ["results/qc_metrics/qc_report.tsv"]
when = "config.modules_qc_enabled"
output = ["results/qc/qc_report.tsv"]
log = "logs/qc/copy_qc_report.txt"
shell = "cp {input[0]} {output[0]}"
tags = ["qc-module"]

[[rules]]
name = "qc_plink"
description = "Run PCA, distance matrix, and KING relatedness via plink"
input = [
    "results/qc/plink_input.vcf.gz",
    "results/qc/plink_input.vcf.gz.csi",
]
when = "config.modules_qc_enabled"
output = [
    "results/qc/plink.bed",
    "results/qc/plink.bim",
    "results/qc/plink.fam",
    "results/qc/plink.eigenvec",
    "results/qc/plink.eigenval",
    "results/qc/plink.dist",
    "results/qc/plink.dist.id",
    "results/qc/plink.king",
]
log = "logs/qc/plink.txt"
shell = """
plink2 --vcf {input[0]} --pca {config.qc_pca_dims} --memory {effective_memory_mb} --out results/qc/plink \\
    --vcf-half-call missing \\
    --mind {config.qc_max_sample_missingness} \\
    --allow-extra-chr --autosome-num 95 --make-bed --make-king square \\
    --const-fid --bad-freqs &> {log}
plink --vcf {input[0]} --out results/qc/plink \\
    --vcf-half-call missing \\
    --mind {config.qc_max_sample_missingness} \\
    --allow-extra-chr --autosome-num 95 --distance square \\
    --const-fid >> {log} 2>&1
"""
tags = ["qc-module"]

[rules.environment]
conda = "envs/qc_plink.yaml"

[[rules]]
name = "qc_setup_admixture"
description = "Back up the PLINK .bim and remap contig names to the integer IDs ADMIXTURE requires"
input = [
    "results/qc/plink.bim",
    "results/qc/contig_map.tsv",
]
when = "config.modules_qc_enabled"
output = [
    "results/qc/plink.bim_fixed",
    "results/qc/plink.bim.orig",
]
log = "logs/qc/setup_admixture.txt"
script = "scripts/contigs4admixture.py {input[1]} {input[0]} {output[0]}"
tags = ["qc-module"]

[[rules]]
name = "qc_admixture"
description = "Run ADMIXTURE for K=2 and K=3"
input = [
    "results/qc/plink.bed",
    "results/qc/plink.bim",
    "results/qc/plink.fam",
    "results/qc/plink.bim_fixed",
    "results/qc/plink.bim.orig",
]
when = "config.modules_qc_enabled"
output = [
    "results/qc/plink.3.Q",
    "results/qc/plink.2.Q",
]
log = "logs/qc/admixture.txt"
shell = """
cp {input[3]} {input[1]} 2> {log}

admixture {input[0]} 2 >> {log} 2>&1
admixture {input[0]} 3 >> {log} 2>&1

mv plink.2.* results/qc >> {log} 2>&1
mv plink.3.* results/qc >> {log} 2>&1
"""
tags = ["qc-module"]

[rules.environment]
conda = "envs/qc_admixture.yaml"

[[rules]]
name = "generate_coords_file"
description = "Generate the QC coordinates file from optional sample metadata (lat/long)"
input = []
when = "config.modules_qc_enabled"
output = ["results/qc/coords.txt"]
log = "logs/qc/generate_coords_file.txt"
script = "scripts/generate_coords.py {config.sample_metadata} {output[0]}"
tags = ["qc-module"]

[[rules]]
name = "qc_dashboard"
description = "Render the interactive QC dashboard"
input = [
    "results/qc/coords.txt",
    "results/qc/plink.eigenvec",
    "results/qc/plink.eigenval",
    "results/qc/individuals.idepth",
    "results/qc/plink.dist",
    "results/qc/plink.dist.id",
    "results/qc/plink.king",
    "results/qc/individuals.imiss",
    "results/qc/plink.3.Q",
    "results/qc/plink.2.Q",
    "results/qc/snpqc.txt",
    "results/qc/plink.bed",
    "results/qc/plink.bim",
    "results/qc/plink.fam",
    "results/qc/individuals.FILTER.summary",
    "results/qc/individuals.het",
    "results/qc/ref.fai",
    "results/qc/qc_report.tsv",
]
when = "config.modules_qc_enabled"
output = ["results/qc/qc_dashboard.html"]
log = "logs/qc/qc_dashboard.txt"
shell = """
# The engine drops empty script args; keep the (possibly empty) API key as a
# quoted shell variable so Rscript always receives all six arguments.
GOOGLE_API_KEY="{config.qc_google_api_key}"
Rscript scripts/qc_dashboard_render.R results/qc {config.qc_clusters} "$GOOGLE_API_KEY" true scripts/qc_dashboard_interactive.Rmd {output[0]}
"""
tags = ["qc-module"]

[rules.environment]
conda = "envs/qc_dashboard.yaml"
