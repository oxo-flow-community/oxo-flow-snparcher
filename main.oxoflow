# ---------------------------------------------------------------------------
# DeepVariant long-contig (CSI) chain: run_deepvariant writes uncompressed
# files, and archive_deepvariant_gvcf compresses the gVCF with a CSI index
# (upstream DEEPVARIANT_CALL_OUTPUT / archive rule in deepvariant.smk).
# ---------------------------------------------------------------------------

[[rules]]
name = "deepvariant_call_long"
description = "Per-sample variant calling with DeepVariant (long-contig CSI; uncompressed temp outputs, archived by archive_deepvariant_gvcf)"
input = [
    "results/bams/merged/{sample}.bam",
    "results/bams/merged/{sample}.bam.csi",
    "results/reference/{config.reference_name}.fa.gz",
    "results/reference/{config.reference_name}.fa.gz.fai",
    "results/reference/{config.reference_name}.dict",
]
when = "config.variant_tool == 'deepvariant' && (!config.mark_duplicates || {meta.mark_duplicates} == 'false') && {meta.mark_duplicates} != 'true' && (wildcard.input_type == 'fastq' || wildcard.input_type == 'srr') && file_exists(\"results/reference/.long_contig.flag\") && config.long_contig_mode != false"
output = [
    "results/deepvariant/{sample}.g.vcf",
    "results/deepvariant/{sample}.vcf",
]
temp_output = [
    "results/deepvariant/{sample}.g.vcf",
    "results/deepvariant/{sample}.vcf",
]
depends_on = ["resolve_long_contig_mode"]
log = "logs/deepvariant_call_long/{sample}.txt"
shell = """
WORK=$(mktemp -d "results/deepvariant/{sample}.XXXXXX")
trap 'rm -rf "$WORK";' EXIT
/opt/deepvariant/bin/run_deepvariant \
    --ref {input[2]} \
    --reads {input[0]} \
    --sample_name {sample} \
    --output_vcf {output[1]} \
    --output_gvcf {output[0]} \
    --model_type {config.deepvariant_model_type} \
    --num_shards {threads} \
    --intermediate_results_dir "$WORK" \
    &> {log}
"""
