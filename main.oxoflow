# snpArcher (harvardinformatics/snparcher @ v2.2) — oxo-flow port
#
# Default-parameters main execution path:
#   sample sheet (FASTQ inputs) -> fastp (read trimming/filtering)
#   -> BWA-MEM + samtools sort -> samtools merge (no duplicate marking)
#   -> GATK HaplotypeCaller (per-sample gVCF) -> QC metrics report
#
# Ported branches, gated by config keys (all default OFF so the default plan
# is unchanged; flip a key to activate a branch — see README fidelity table):
#   mark_duplicates=true        sambamba markdup + merge (upstream default true)
#   variant_tool='deepvariant'  DeepVariant per-sample gVCF calling (docker)
#   variant_tool='bcftools'     bcftools mpileup+call caller (runtime-region
#                               fan-out via output_pattern, engine >= 0.17)
#   intervals_enabled=true      GATK interval scatter (SplitIntervals fan-out
#                               via output_pattern, engine >= 0.17)
#   joint_genotyping_enabled=true   GATK GenomicsDBImport + GenotypeGVCFs
#                               (deepvariant: GLnexus joint genotyping)
#   generate_filtered_vcf=true  GATK hard variant filtration (needs joint VCF)
#   callable_sites_enabled=true mosdepth/clam coverage + genmap mappability
#                               -> results/callable_sites/callable_sites.bed
#   modules_postprocess_enabled=true  postprocess module (needs callable BED)
#   modules_qc_enabled=true     qc module (plink/admixture/dashboard)
#   input_type per sample group: 'fastq' (default), 'srr' (SRA download +
#   fastp), 'bam' (stage external BAM), or 'gvcf' (external gVCF, normalized
#   straight into joint genotyping) — set in [[sample_groups]] metadata
#
# Remaining structural exclusions (impossible in oxo-flow — see README):
#   parabricks (GPU --nv passthrough + NVIDIA license), sentieon
#   (proprietary license). The snakemake checkpoint fan-outs (interval
#   scatter, bcftools regions) are ported with the engine's output_pattern
#   primitive; see the "Interval scatter (GATK)" and "bcftools caller"
#   sections below.

[workflow]
name = "snparcher"
version = "2.2.0"
description = "Variant calling for non-model organisms — fastp, BWA-MEM, GATK HaplotypeCaller. oxo-flow port of harvardinformatics/snparcher v2.2."
author = "oxo-flow-community"

[config]
reference_name = "my_organism"
reference_source = "test/fixtures/ref/genome.fa"
expected_coverage = "low"
ploidy = 2
mark_duplicates = false
intervals_enabled = false
intervals_scatter_count = 50
intervals_db_scatter_factor = 0.15
intervals_min_nmer = 500
intervals_min_contig_length = 0
intervals_db_max_intervals_per_shard = 200
intervals_db_max_contigs_per_shard = 200
bcftools_min_mapq = 20
bcftools_min_baseq = 20
bcftools_max_depth = 250
variant_tool = "gatk"
joint_genotyping_enabled = false
generate_filtered_vcf = false
callable_sites_enabled = false
modules_postprocess_enabled = false
modules_qc_enabled = false
gatk_het_prior = 0.005
deepvariant_model_type = "WGS"
callable_sites_min_coverage = "auto"
callable_sites_max_coverage = "auto"
callable_sites_fraction = 1.0
callable_sites_merge_distance = 100
callable_sites_kmer = 150
callable_sites_min_score = 1
postprocess_contig_size = 10000
postprocess_maf = 0.01
postprocess_missingness = 0.75
postprocess_exclude_scaffolds = "mtDNA,Y"
qc_min_depth = 2
qc_max_sample_missingness = 0.49
qc_exclude_scaffolds = ""
qc_clusters = 3
qc_pca_dims = 10
qc_google_api_key = ""
sample_metadata = ""

[defaults]
memory = "8G"

# Sample groups. The default cohort uses local paired FASTQs (input_type
# "fastq"). Rule fan-out is per (rule, group, sample) with wildcard gates on
# `wildcard.input_type`, so a group's input type routes its samples through
# the matching branch. Group names become rule-instance names — keep them
# stable. To add other input types, add groups like:
#
#   # SRA inputs (download_sra -> fastp_srr): accession is required metadata
#   [[sample_groups]]
#   name = "sra"
#   samples = ["my_sra_sample"]
#   metadata = { input_type = "srr", accession = "SRR12345678" }
#
#   # External BAM inputs (stage_external_bam): bam_path is required metadata
#   [[sample_groups]]
#   name = "external"
#   samples = ["my_bam_sample"]
#   metadata = { input_type = "bam", bam_path = "/path/to/sample.bam" }
#
#   # External gVCF inputs (normalize_external_gvcf_for_gatk -> joint
#   # genotyping; requires joint_genotyping_enabled = true):
#   # gvcf_path is required metadata
#   [[sample_groups]]
#   name = "external_gvcfs"
#   samples = ["my_gvcf_sample"]
#   metadata = { input_type = "gvcf", gvcf_path = "/path/to/sample.g.vcf.gz" }
#
# Upstream's sample sheet columns (sample_id, input_type, input, library_id,
# mark_duplicates) map to: sample id = [[sample_groups]] entry, input_type =
# metadata.input_type, input = metadata (accession / bam_path / raw FASTQs),
# library_id = sample id, mark_duplicates = global config. Per-sample
# mark_duplicates overrides are not ported.

[[sample_groups]]
name = "cohort"
samples = ["sample1", "sample2", "sample3"]
metadata = { input_type = "fastq" }

# ---------------------------------------------------------------------------
# Reference preparation
# ---------------------------------------------------------------------------

[[rules]]
name = "prepare_reference"
description = "Prepare the reference genome as a bgzip-compressed FASTA"
input = []
output = ["results/reference/{config.reference_name}.fa.gz"]
log = "logs/prepare_reference/{config.reference_name}.txt"
shell = """
if [[ "{config.reference_source}" == *.gz ]]; then
    gunzip -c "{config.reference_source}" | bgzip -c > {output[0]}
else
    bgzip -c "{config.reference_source}" > {output[0]}
fi
"""

[rules.environment]
conda = "envs/reference.yaml"

[[rules]]
name = "index_reference"
description = "Index the reference (samtools faidx/dict, BWA index)"
input = ["results/reference/{config.reference_name}.fa.gz"]
output = [
    "results/reference/{config.reference_name}.fa.gz.gzi",
    "results/reference/{config.reference_name}.fa.gz.fai",
    "results/reference/{config.reference_name}.dict",
    "results/reference/{config.reference_name}.fa.gz.sa",
    "results/reference/{config.reference_name}.fa.gz.pac",
    "results/reference/{config.reference_name}.fa.gz.bwt",
    "results/reference/{config.reference_name}.fa.gz.ann",
    "results/reference/{config.reference_name}.fa.gz.amb",
]
log = "logs/index_reference/{config.reference_name}.txt"
shell = """
samtools faidx {input[0]}
samtools dict {input[0]} -o {output[2]}
bwa index {input[0]}
"""

[rules.environment]
conda = "envs/reference.yaml"

# ---------------------------------------------------------------------------
# Read acquisition and trimming / filtering (fastp)
# ---------------------------------------------------------------------------

[[rules]]
name = "fastp"
description = "Adapter detection and quality filtering of read pairs with fastp (local FASTQ inputs)"
input = [
    "raw/{sample}_1.fastq.gz",
    "raw/{sample}_2.fastq.gz",
]
output = [
    "results/filtered_fastqs/{sample}/{sample}/u1_1.fastq.gz",
    "results/filtered_fastqs/{sample}/{sample}/u1_2.fastq.gz",
    "results/fastp/{sample}/{sample}/u1.json",
]
when = "wildcard.input_type == 'fastq'"
log = "logs/fastp/{sample}.txt"
shell = """
fastp \
    --in1 {input[0]} \
    --in2 {input[1]} \
    --out1 {output[0]} \
    --out2 {output[1]} \
    --thread {threads} \
    --detect_adapter_for_pe \
    -j {output[2]} \
    -h /dev/null
"""
tags = ["qc", "trimming"]

[rules.resources]
threads = 4

[rules.environment]
conda = "envs/fastp.yaml"

[[rules]]
name = "download_sra"
description = "Download SRA run as paired FASTQs (prefetch/fasterq-dump, ENA via ffq fallback)"
output = [
    "results/fastqs/{sample}/{sample}/u1/{accession}_1.fastq.gz",
    "results/fastqs/{sample}/{sample}/u1/{accession}_2.fastq.gz",
]
when = "wildcard.input_type == 'srr'"
log = "logs/download_sra/{sample}/{accession}.txt"
shell = """
rm -rf {accession}
mkdir -p results/fastqs/{sample}/{sample}/u1

if prefetch --max-size 1T {accession} 2>> {log}; then
    fasterq-dump {accession} \\
        -O results/fastqs/{sample}/{sample}/u1 \\
        -e {threads} \\
        >> {log} 2>&1
    pigz -p {threads} results/fastqs/{sample}/{sample}/u1/{accession}*.fastq
    rm -rf {accession}
else
    echo "Prefetch failed, trying ENA via ffq..." >> {log}
    ffq --ftp {accession} 2>> {log} \\
        | jq -r '.[].url' \\
        | while IFS= read -r url; do
            [[ -n "$url" ]] || continue
            echo "Downloading: $url" >> {log}
            curl -fSL "$url" \\
                -o results/fastqs/{sample}/{sample}/u1/$(basename "$url") \\
                >> {log} 2>&1
        done
fi

[[ -f {output[0]} ]] && [[ -f {output[1]} ]]
"""
tags = ["read-acquisition"]

[rules.resources]
threads = 4

[rules.environment]
conda = "envs/sra.yaml"

[[rules]]
name = "fastp_srr"
description = "Adapter detection and quality filtering of downloaded SRA read pairs with fastp"
input = [
    "results/fastqs/{sample}/{sample}/u1/{accession}_1.fastq.gz",
    "results/fastqs/{sample}/{sample}/u1/{accession}_2.fastq.gz",
]
output = [
    "results/filtered_fastqs/{sample}/{sample}/u1_1.fastq.gz",
    "results/filtered_fastqs/{sample}/{sample}/u1_2.fastq.gz",
    "results/fastp/{sample}/{sample}/u1.json",
]
when = "wildcard.input_type == 'srr'"
log = "logs/fastp_srr/{sample}.txt"
shell = """
fastp \
    --in1 {input[0]} \
    --in2 {input[1]} \
    --out1 {output[0]} \
    --out2 {output[1]} \
    --thread {threads} \
    --detect_adapter_for_pe \
    -j {output[2]} \
    -h /dev/null
"""
tags = ["qc", "trimming"]

[rules.resources]
threads = 4

[rules.environment]
conda = "envs/fastp.yaml"

# ---------------------------------------------------------------------------
# Alignment (BWA-MEM) and BAM merging
# ---------------------------------------------------------------------------

[[rules]]
name = "bwa_mem"
description = "Align reads with bwa mem and sort with samtools"
input = [
    "results/filtered_fastqs/{sample}/{sample}/u1_1.fastq.gz",
    "results/filtered_fastqs/{sample}/{sample}/u1_2.fastq.gz",
    "results/reference/{config.reference_name}.fa.gz",
    "results/reference/{config.reference_name}.fa.gz.fai",
    "results/reference/{config.reference_name}.dict",
]
when = "(wildcard.input_type == 'fastq' || wildcard.input_type == 'srr')"
output = ["results/bams/raw/{sample}/{sample}/u1.bam"]
temp_output = ["results/bams/raw/{sample}/{sample}/u1.bam"]
log = "logs/bwa_mem/{sample}.txt"
shell = """
bwa mem -M -t {threads} -R "@RG\\tID:{sample}.u1\\tSM:{sample}\\tLB:{sample}\\tPL:ILLUMINA" \
    {input[2]} {input[0]} {input[1]} | samtools sort -o {output[0]} -
"""
tags = ["alignment"]

[rules.resources]
threads = 8

[rules.environment]
conda = "envs/samtools.yaml"

[[rules]]
name = "merge_library_bams"
description = "Merge per-input-unit BAMs into a per-library BAM"
input = ["results/bams/raw/{sample}/{sample}/u1.bam"]
when = "(wildcard.input_type == 'fastq' || wildcard.input_type == 'srr')"
output = ["results/bams/library/{sample}/{sample}.bam"]
temp_output = ["results/bams/library/{sample}/{sample}.bam"]
log = "logs/merge_library_bams/{sample}.txt"
shell = "samtools merge -f {output[0]} {input[0]}"
tags = ["alignment"]

[rules.environment]
conda = "envs/samtools.yaml"

[[rules]]
name = "merge_library_level_bams"
description = "Merge per-library BAMs into the final sample BAM (no duplicate marking)"
input = ["results/bams/library/{sample}/{sample}.bam"]
when = "!config.mark_duplicates && (wildcard.input_type == 'fastq' || wildcard.input_type == 'srr')"
output = ["results/bams/merged/{sample}.bam"]
log = "logs/merge_library_level_bams/{sample}.txt"
shell = "samtools merge -f {output[0]} {input[0]}"
tags = ["alignment"]

[rules.environment]
conda = "envs/samtools.yaml"

[[rules]]
name = "markdup_library"
description = "Mark duplicate reads per library with sambamba (upstream default branch)"
input = ["results/bams/library/{sample}/{sample}.bam"]
when = "config.mark_duplicates && (wildcard.input_type == 'fastq' || wildcard.input_type == 'srr')"
output = ["results/bams/library_markdup/{sample}/{sample}.bam"]
temp_output = ["results/bams/library_markdup/{sample}/{sample}.bam"]
log = "logs/markdup/{sample}.txt"
shell = """
sambamba markdup -t {threads} {input[0]} {output[0]} 2> {log}
rm -f {output[0]}.bai
"""
tags = ["alignment"]

[rules.resources]
threads = 4

[rules.environment]
conda = "envs/sambamba.yaml"

[[rules]]
name = "merge_dedup_libraries"
description = "Merge duplicate-marked library BAMs into the final sample BAM"
input = ["results/bams/library_markdup/{sample}/{sample}.bam"]
when = "config.mark_duplicates && (wildcard.input_type == 'fastq' || wildcard.input_type == 'srr')"
output = ["results/bams/markdup/{sample}.bam"]
log = "logs/merge_dedup_libraries/{sample}.txt"
shell = "samtools merge -f {output[0]} {input[0]}"
tags = ["alignment"]

[rules.environment]
conda = "envs/samtools.yaml"

[[rules]]
name = "stage_external_bam"
description = "Stage an external BAM input as a symlink into the workflow's BAM tree"
input = ["{bam_path}"]
when = "wildcard.input_type == 'bam'"
output = ["results/bams/input/{sample}.bam"]
log = "logs/stage_external_bam/{sample}.txt"
shell = "ln -sf {input[0]} {output[0]} 2> {log}"
tags = ["alignment"]

[[rules]]
name = "index_bam_csi"
description = "Index the final BAM with CSI (required by GATK)"
input = ["results/bams/merged/{sample}.bam"]
when = "!config.mark_duplicates && (wildcard.input_type == 'fastq' || wildcard.input_type == 'srr')"
output = ["results/bams/merged/{sample}.bam.csi"]
log = "logs/index_bam_csi/{sample}.txt"
shell = "samtools index -c {input[0]} {output[0]}"
tags = ["alignment"]

[rules.environment]
conda = "envs/samtools.yaml"

[[rules]]
name = "index_bam_csi_markdup"
description = "Index the duplicate-marked final BAM with CSI"
input = ["results/bams/markdup/{sample}.bam"]
when = "config.mark_duplicates && (wildcard.input_type == 'fastq' || wildcard.input_type == 'srr')"
output = ["results/bams/markdup/{sample}.bam.csi"]
log = "logs/index_bam_csi_markdup/{sample}.txt"
shell = "samtools index -c {input[0]} {output[0]}"
tags = ["alignment"]

[rules.environment]
conda = "envs/samtools.yaml"

[[rules]]
name = "index_bam_csi_external"
description = "Index the staged external BAM with CSI"
input = ["results/bams/input/{sample}.bam"]
when = "wildcard.input_type == 'bam'"
output = ["results/bams/input/{sample}.bam.csi"]
log = "logs/index_bam_csi_external/{sample}.txt"
shell = "samtools index -c {input[0]} {output[0]}"
tags = ["alignment"]

[rules.environment]
conda = "envs/samtools.yaml"

[[rules]]
name = "normalize_external_gvcf_for_gatk"
description = "Normalize an external gVCF input (recompress + tabix index) for joint genotyping"
input = ["{gvcf_path}"]
when = "wildcard.input_type == 'gvcf'"
output = [
    "results/gvcfs/{sample}.g.vcf.gz",
    "results/gvcfs/{sample}.g.vcf.gz.tbi",
]
log = "logs/normalize_external_gvcf_for_gatk/{sample}.txt"
shell = """
bcftools view -Oz -o {output[0]} {input[0]} 2> {log}
bcftools index -t {output[0]} 2>> {log}
"""
tags = ["variant-calling"]

[rules.environment]
conda = "envs/bcftools.yaml"

# ---------------------------------------------------------------------------
# Interval scatter (GATK, gated by intervals_enabled)
#
# Port of upstream's checkpoint-based interval fan-out (workflow/rules/
# intervals.smk:59,89 + variant_calling/gatk_intervals.smk) on the engine's
# output_pattern primitive: SplitIntervals output names are unknown until the
# run, so the splitter is an output_pattern producer and every per-interval
# rule below is a deferred consumer instantiated once per discovered file.
#
# Upstream splits ONCE per cohort; oxo-flow's output_pattern domain carries
# the instance bindings of its producer, so the gVCF splitter fans out per
# sample to give the per-(sample, interval) HaplotypeCaller instances their
# sample dimension. SplitIntervals is deterministic, so every sample gets an
# identical copy of the interval set (deviation: N-1 redundant tiny runs).
# The DB splitter stays cohort-level (its consumers are per-interval, not
# per-sample) and uses a separate wildcard {db_interval}: one fresh wildcard
# may have only one producer (v1).
# ---------------------------------------------------------------------------

[[rules]]
name = "picard_intervals"
description = "Split the reference into N-mers with picard ScatterIntervalsByNs (interval mode)"
input = [
    "results/reference/{config.reference_name}.fa.gz",
    "results/reference/{config.reference_name}.fa.gz.fai",
    "results/reference/{config.reference_name}.dict",
]
when = "config.intervals_enabled && config.variant_tool == 'gatk'"
output = ["results/intervals/picard.interval_list"]
log = "logs/intervals_picard.txt"
shell = """
picard ScatterIntervalsByNs \
    -Xmx7000m \
    REFERENCE={input[0]} \
    OUTPUT={output[0]} \
    MAX_TO_MERGE={config.intervals_min_nmer} \
    OUTPUT_TYPE=ACGT \
    &> {log}
"""
tags = ["variant-calling"]

[rules.resources]
threads = 1

[rules.environment]
conda = "envs/gatk.yaml"

[[rules]]
name = "filter_picard_intervals"
description = "Drop intervals on contigs shorter than the configured minimum (interval mode)"
input = ["results/intervals/picard.interval_list"]
when = "config.intervals_enabled && config.variant_tool == 'gatk'"
output = ["results/intervals/filtered.interval_list"]
log = "logs/intervals_filter.txt"
script = "python scripts/interval_list_tools.py filter --input {input[0]} --output {output[0]} --min-contig-length {config.intervals_min_contig_length} &> {log}"
tags = ["variant-calling"]

[rules.resources]
threads = 1

[rules.environment]
conda = "envs/gatk.yaml"

[[rules]]
name = "create_gvcf_intervals"
description = "Split the filtered interval list into scatter intervals (gVCF mode, output_pattern producer)"
input = [
    "results/intervals/filtered.interval_list",
    "results/reference/{config.reference_name}.fa.gz",
    "results/reference/{config.reference_name}.fa.gz.fai",
    "results/reference/{config.reference_name}.dict",
]
when = "config.intervals_enabled && config.variant_tool == 'gatk' && wildcard.input_type != 'gvcf'"
output_pattern = "results/intervals/gvcf/{sample}/{interval}-scattered.interval_list"
log = "logs/create_gvcf_intervals/{sample}.txt"
shell = """
mkdir -p results/intervals/gvcf/{sample}
gatk SplitIntervals \
    --java-options '-Xmx7000m' \
    -R {input[1]} \
    -L {input[0]} \
    -O results/intervals/gvcf/{sample} \
    --scatter-count {config.intervals_scatter_count} \
    --subdivision-mode BALANCING_WITHOUT_INTERVAL_SUBDIVISION \
    --interval-merging-rule OVERLAPPING_ONLY \
    &> {log}
ls -1 results/intervals/gvcf/{sample}/*-scattered.interval_list > results/intervals/gvcf/{sample}/intervals.txt
"""
tags = ["variant-calling"]

[rules.resources]
threads = 1

[rules.environment]
conda = "envs/gatk.yaml"

[[rules]]
name = "gatk_haplotypecaller_interval"
description = "Per-interval HaplotypeCaller to gVCF (interval mode, no-markdup BAM)"
input = [
    "results/bams/merged/{sample}.bam",
    "results/bams/merged/{sample}.bam.csi",
    "results/reference/{config.reference_name}.fa.gz",
    "results/reference/{config.reference_name}.fa.gz.fai",
    "results/reference/{config.reference_name}.dict",
    "results/intervals/gvcf/{sample}/{interval}-scattered.interval_list",
]
when = "config.intervals_enabled && config.variant_tool == 'gatk' && !config.mark_duplicates && (wildcard.input_type == 'fastq' || wildcard.input_type == 'srr')"
output = [
    "results/interval_gvcfs/{sample}/{interval}.g.vcf.gz",
    "results/interval_gvcfs/{sample}/{interval}.g.vcf.gz.tbi",
]
log = "logs/gatk_haplotypecaller_interval/{sample}/{interval}.txt"
shell = """
gatk HaplotypeCaller \
    --java-options '-Xmx7000m' \
    -R {input[2]} \
    -I {input[0]} \
    --read-index {input[1]} \
    -L {input[5]} \
    -O {output[0]} \
    -ploidy {config.ploidy} \
    --native-pair-hmm-threads {threads} \
    --emit-ref-confidence GVCF \
    --min-pruning 1 \
    --min-dangling-branch-length 1
"""
tags = ["variant-calling"]

[rules.resources]
threads = 1

[rules.environment]
conda = "envs/gatk.yaml"

[[rules]]
name = "gatk_haplotypecaller_interval_markdup"
description = "Per-interval HaplotypeCaller to gVCF (interval mode, duplicate-marked BAM)"
input = [
    "results/bams/markdup/{sample}.bam",
    "results/bams/markdup/{sample}.bam.csi",
    "results/reference/{config.reference_name}.fa.gz",
    "results/reference/{config.reference_name}.fa.gz.fai",
    "results/reference/{config.reference_name}.dict",
    "results/intervals/gvcf/{sample}/{interval}-scattered.interval_list",
]
when = "config.intervals_enabled && config.variant_tool == 'gatk' && config.mark_duplicates && (wildcard.input_type == 'fastq' || wildcard.input_type == 'srr')"
output = [
    "results/interval_gvcfs/{sample}/{interval}.g.vcf.gz",
    "results/interval_gvcfs/{sample}/{interval}.g.vcf.gz.tbi",
]
log = "logs/gatk_haplotypecaller_interval_markdup/{sample}/{interval}.txt"
shell = """
gatk HaplotypeCaller \
    --java-options '-Xmx7000m' \
    -R {input[2]} \
    -I {input[0]} \
    --read-index {input[1]} \
    -L {input[5]} \
    -O {output[0]} \
    -ploidy {config.ploidy} \
    --native-pair-hmm-threads {threads} \
    --emit-ref-confidence GVCF \
    --min-pruning 1 \
    --min-dangling-branch-length 1
"""
tags = ["variant-calling"]

[rules.resources]
threads = 1

[rules.environment]
conda = "envs/gatk.yaml"

[[rules]]
name = "gatk_haplotypecaller_interval_external"
description = "Per-interval HaplotypeCaller to gVCF (interval mode, staged external BAM)"
input = [
    "results/bams/input/{sample}.bam",
    "results/bams/input/{sample}.bam.csi",
    "results/reference/{config.reference_name}.fa.gz",
    "results/reference/{config.reference_name}.fa.gz.fai",
    "results/reference/{config.reference_name}.dict",
    "results/intervals/gvcf/{sample}/{interval}-scattered.interval_list",
]
when = "config.intervals_enabled && config.variant_tool == 'gatk' && wildcard.input_type == 'bam'"
output = [
    "results/interval_gvcfs/{sample}/{interval}.g.vcf.gz",
    "results/interval_gvcfs/{sample}/{interval}.g.vcf.gz.tbi",
]
log = "logs/gatk_haplotypecaller_interval_external/{sample}/{interval}.txt"
shell = """
gatk HaplotypeCaller \
    --java-options '-Xmx7000m' \
    -R {input[2]} \
    -I {input[0]} \
    --read-index {input[1]} \
    -L {input[5]} \
    -O {output[0]} \
    -ploidy {config.ploidy} \
    --native-pair-hmm-threads {threads} \
    --emit-ref-confidence GVCF \
    --min-pruning 1 \
    --min-dangling-branch-length 1
"""
tags = ["variant-calling"]

[rules.resources]
threads = 1

[rules.environment]
conda = "envs/gatk.yaml"

[[rules]]
name = "concat_interval_gvcfs"
description = "Merge per-interval gVCFs into the per-sample gVCF (interval mode)"
input = ["results/interval_gvcfs/{sample}/*.g.vcf.gz"]
when = "config.intervals_enabled && config.variant_tool == 'gatk' && wildcard.input_type != 'gvcf'"
output = [
    "results/gvcfs/{sample}.g.vcf.gz",
    "results/gvcfs/{sample}.g.vcf.gz.tbi",
]
depends_on = ["create_gvcf_intervals"]
log = "logs/concat_interval_gvcfs/{sample}.txt"
shell = """
bcftools concat -D -a -Ou {input} 2> {log} \
    | bcftools sort -T . -Oz -o {output[0]} 2>> {log}
bcftools index -t {output[0]} 2>> {log}
"""
tags = ["variant-calling"]

[rules.resources]
threads = 1

[rules.environment]
conda = "envs/bcftools.yaml"

[[rules]]
name = "create_db_intervals"
description = "Split the filtered interval list into DB scatter shards (joint genotyping, interval mode, output_pattern producer)"
input = [
    "results/intervals/filtered.interval_list",
    "results/reference/{config.reference_name}.fa.gz",
    "results/reference/{config.reference_name}.fa.gz.fai",
    "results/reference/{config.reference_name}.dict",
]
when = "config.intervals_enabled && config.joint_genotyping_enabled && config.variant_tool == 'gatk'"
output_pattern = "results/intervals/db/{db_interval}-scattered.interval_list"
log = "logs/create_db_intervals.txt"
shell = """
: > {log}
mkdir -p results/intervals/db
raw_dir=$(mktemp -d results/intervals/db/gatk_split_raw.XXXXXX)
trap 'rm -rf "$raw_dir"' EXIT
NUM_SAMPLES=$(echo "{config.samples_list}" | tr ',' '\n' | grep -c . || true)
DB_SCATTER=$(awk -v n="$NUM_SAMPLES" -v f="{config.intervals_db_scatter_factor}" -v g="{config.intervals_scatter_count}" 'BEGIN { c = int(f * n * g); print (c < 1 ? 1 : c) }')
gatk SplitIntervals \
    --java-options '-Xmx7000m' \
    -R {input[1]} \
    -L {input[0]} \
    -O "$raw_dir" \
    --scatter-count "$DB_SCATTER" \
    --subdivision-mode INTERVAL_SUBDIVISION \
    --interval-merging-rule OVERLAPPING_ONLY \
    >> {log} 2>&1
python scripts/interval_list_tools.py split-db \
    --input-dir "$raw_dir" \
    --output-dir results/intervals/db \
    --fof results/intervals/db/intervals.txt \
    --max-intervals-per-shard {config.intervals_db_max_intervals_per_shard} \
    --max-contigs-per-shard {config.intervals_db_max_contigs_per_shard} \
    --merge-contigs-threshold 50 \
    >> {log} 2>&1
"""
tags = ["variant-calling"]

[rules.resources]
threads = 1

[rules.environment]
conda = "envs/gatk.yaml"

[[rules]]
name = "gatk_genomics_db_import_interval"
description = "Import all sample gVCFs into one per-shard GenomicsDB workspace (interval mode)"
input = [
    "results/genomics_db/mapfile.txt",
    "results/reference/{config.reference_name}.fa.gz",
    "results/reference/{config.reference_name}.fa.gz.fai",
    "results/reference/{config.reference_name}.dict",
    "results/intervals/db/{db_interval}-scattered.interval_list",
]
expand_inputs = [
    { pattern = "results/gvcfs/{sample}.g.vcf.gz", variables = { sample = "config.samples_list" } },
    { pattern = "results/gvcfs/{sample}.g.vcf.gz.tbi", variables = { sample = "config.samples_list" } },
]
when = "config.intervals_enabled && config.joint_genotyping_enabled && config.variant_tool == 'gatk'"
output = [
    "results/gatk_genomics_db/L{db_interval}.tar",
]
temp_output = ["results/gatk_genomics_db/L{db_interval}.tar"]
log = "logs/gatk_genomics_db_import_interval/{db_interval}.txt"
shell = """
: > {log}
export TILEDB_DISABLE_FILE_LOCKING=1
DB_DIR="results/gatk_genomics_db/L{db_interval}"
rm -rf "$DB_DIR"
trap 'rm -rf "$DB_DIR"' EXIT
MERGE_CONTIGS_ARG=$(python scripts/interval_list_tools.py genomicsdb-merge-contigs-arg \\
    --input {input[4]} \\
    --threshold 50 2>> {log})
gatk GenomicsDBImport \
    --java-options '-Xmx7000m' \
    --genomicsdb-shared-posixfs-optimizations true \
    --batch-size 25 \
    --genomicsdb-workspace-path "$DB_DIR" \
    --merge-input-intervals $MERGE_CONTIGS_ARG \
    --reader-threads {threads} \
    -L {input[4]} \
    --sample-name-map {input[0]} \
    >> {log} 2>&1
tar -cf {output[0]} "$DB_DIR" >> {log} 2>&1
"""
tags = ["variant-calling"]

[rules.resources]
threads = 1

[rules.environment]
conda = "envs/gatk.yaml"

[[rules]]
name = "gatk_genotype_gvcfs_interval"
description = "Jointly genotype one DB shard (interval mode)"
input = [
    "results/gatk_genomics_db/L{db_interval}.tar",
    "results/reference/{config.reference_name}.fa.gz",
    "results/reference/{config.reference_name}.fa.gz.fai",
    "results/reference/{config.reference_name}.dict",
]
when = "config.intervals_enabled && config.joint_genotyping_enabled && config.variant_tool == 'gatk'"
output = [
    "results/vcfs/intervals/L{db_interval}.vcf.gz",
    "results/vcfs/intervals/L{db_interval}.vcf.gz.tbi",
]
log = "logs/gatk_genotype_gvcfs_interval/{db_interval}.txt"
shell = """
EXTRACT_DIR=$(mktemp -d .oxo-joint-gvcf.XXXXXX)
trap 'rm -rf "$EXTRACT_DIR"' EXIT
tar -xf {input[0]} -C "$EXTRACT_DIR"
gatk GenotypeGVCFs \
    --java-options '-Xmx7000m' \
    -R {input[1]} \
    --heterozygosity {config.gatk_het_prior} \
    --genomicsdb-shared-posixfs-optimizations true \
    -V gendb://"$EXTRACT_DIR/results/gatk_genomics_db/L{db_interval}" \
    -O {output[0]} \
    &> {log}
"""
tags = ["variant-calling"]

[rules.resources]
threads = 1

[rules.environment]
conda = "envs/gatk.yaml"

[[rules]]
name = "concat_interval_vcfs"
description = "Concatenate per-shard raw VCFs into the joint raw VCF (interval mode)"
input = ["results/vcfs/intervals/*.vcf.gz"]
when = "config.intervals_enabled && config.joint_genotyping_enabled && config.variant_tool == 'gatk'"
output = [
    "results/vcfs/raw.vcf.gz",
    "results/vcfs/raw.vcf.gz.tbi",
]
temp_output = [
    "results/vcfs/raw.vcf.gz",
    "results/vcfs/raw.vcf.gz.tbi",
]
depends_on = ["create_db_intervals"]
log = "logs/concat_interval_vcfs.txt"
shell = """
bcftools concat -D -a -Ou {input} 2> {log} \
    | bcftools sort -T . -Oz -o {output[0]} 2>> {log}
bcftools index -t {output[0]} 2>> {log}
"""
tags = ["variant-calling"]

[rules.resources]
threads = 1

[rules.environment]
conda = "envs/bcftools.yaml"

# ---------------------------------------------------------------------------
