[[rules]]
name = "compress_joint_raw_vcf"
description = "Compress and CSI-index the long-contig joint work VCF into the joint raw VCF (upstream compress_joint_raw_vcf)"
input = [
    "results/vcfs/work/raw.vcf",
    "results/vcfs/work/raw.vcf.idx",
]
when = "config.joint_genotyping_enabled && config.variant_tool == 'gatk' && !config.intervals_enabled && file_exists(\"results/reference/.long_contig.flag\") && config.long_contig_mode != false"
