# Upstream archive_gatk_gvcf (gatk_gvcf.smk): compresses the long-mode work
# gVCF into the durable .gz + CSI deliverable. One rule per input family
# (the port has no per-sample lambda); each mirrors its HaplotypeCaller
# twin's gate minus !intervals, so it also archives the interval-mode
# concat output.
[[rules]]
name = "archive_gatk_gvcf"
description = "Compress and CSI-index the long-contig work gVCF into the durable gVCF deliverable (no-markdup BAM)"
input = [
    "results/gvcfs/work/{sample}.g.vcf",
    "results/gvcfs/work/{sample}.g.vcf.idx",
]
when = "config.variant_tool == 'gatk' && (!config.mark_duplicates || {meta.mark_duplicates} == 'false') && {meta.mark_duplicates} != 'true' && (wildcard.input_type == 'fastq' || wildcard.input_type == 'srr') && file_exists(\"results/reference/.long_contig.flag\") && config.long_contig_mode != false"
output = [
    "results/gvcfs/{sample}.g.vcf.gz",
    "results/gvcfs/{sample}.g.vcf.gz.csi",
]
depends_on = ["resolve_long_contig_mode"]
log = "logs/archive_gatk_gvcf/{sample}.txt"
shell = """
bcftools view -Oz -o {output[0]} {input[0]} 2> {log}
bcftools index -f -c {output[0]} 2>> {log}
"""
tags = ["variant-calling"]

[rules.environment]
conda = "envs/bcftools.yaml"

[[rules]]
name = "archive_gatk_gvcf_markdup"
description = "Compress and CSI-index the long-contig work gVCF into the durable gVCF deliverable (duplicate-marked BAM)"
input = [
    "results/gvcfs/work/{sample}.g.vcf",
    "results/gvcfs/work/{sample}.g.vcf.idx",
]
when = "config.variant_tool == 'gatk' && (config.mark_duplicates || {meta.mark_duplicates} == 'true') && {meta.mark_duplicates} != 'false' && (wildcard.input_type == 'fastq' || wildcard.input_type == 'srr') && file_exists(\"results/reference/.long_contig.flag\") && config.long_contig_mode != false"
output = [
    "results/gvcfs/{sample}.g.vcf.gz",
    "results/gvcfs/{sample}.g.vcf.gz.csi",
]
depends_on = ["resolve_long_contig_mode"]
log = "logs/archive_gatk_gvcf_markdup/{sample}.txt"
shell = """
bcftools view -Oz -o {output[0]} {input[0]} 2> {log}
bcftools index -f -c {output[0]} 2>> {log}
"""
tags = ["variant-calling"]

[rules.environment]
conda = "envs/bcftools.yaml"

[[rules]]
name = "archive_gatk_gvcf_external"
description = "Compress and CSI-index the long-contig work gVCF into the durable gVCF deliverable (staged external BAM)"
input = [
    "results/gvcfs/work/{sample}.g.vcf",
    "results/gvcfs/work/{sample}.g.vcf.idx",
]
when = "config.variant_tool == 'gatk' && wildcard.input_type == 'bam' && file_exists(\"results/reference/.long_contig.flag\") && config.long_contig_mode != false"
