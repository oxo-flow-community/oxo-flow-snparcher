# snpArcher (harvardinformatics/snparcher @ v2.3.0) — oxo-flow port
#
# Default-parameters main execution path:
#   sample sheet (FASTQ inputs) -> fastp (read trimming/filtering)
#   -> BWA-MEM + samtools sort -> samtools merge (no duplicate marking)
#   -> GATK HaplotypeCaller (per-sample gVCF) -> QC metrics report
#
# Ported branches, gated by config keys (all default OFF so the default plan
# is unchanged; flip a key to activate a branch — see README fidelity table):
#   mark_duplicates=true        sambamba markdup + merge (upstream default true);
#                                 per-sample override via the optional [workflow]
#                                 metadata_file mark_duplicates column (see README)
#   variant_tool='deepvariant'  DeepVariant per-sample gVCF calling (docker)
#   variant_tool='bcftools'     bcftools mpileup+call caller (runtime-region
#                               fan-out via output_pattern, engine >= 0.17)
#   intervals_enabled=true      GATK interval scatter (SplitIntervals fan-out
#                               via output_pattern, engine >= 0.17)
#   joint_genotyping_enabled=true   GATK GenomicsDBImport + GenotypeGVCFs
#                               (deepvariant: GLnexus joint genotyping)
#   generate_filtered_vcf=true  GATK hard variant filtration (needs joint VCF)
#   long_contig_mode='auto'     long-contig (CSI) VCF indexing when any contig
#                               exceeds the TBI 512 Mb limit (auto/true/false;
#                               interval-mode GATK chain emits .csi and keeps
#                               GATK consumers on plain .vcf + .idx)
#   callable_sites_enabled=true mosdepth/clam coverage + genmap mappability
#                               -> results/callable_sites/callable_sites.bed
#   modules_postprocess_enabled=true  postprocess module (needs callable BED)
#   modules_qc_enabled=true     qc module (plink/admixture/dashboard)
#   input_type per sample group: 'fastq' (default), 'srr' (SRA download +
#   fastp), 'bam' (stage external BAM), or 'gvcf' (external gVCF, normalized
#   straight into joint genotyping) — set in [[sample_groups]] metadata
#
# Remaining structural exclusions (impossible in oxo-flow — see README):
#   parabricks (GPU --nv passthrough + NVIDIA license), sentieon
#   (proprietary license). The snakemake checkpoint fan-outs (interval
#   scatter, bcftools regions) are ported with the engine's output_pattern
#   primitive; see the "Interval scatter (GATK)" and "bcftools caller"
#   sections below.

[workflow]
name = "snparcher"
version = "2.3.0"
description = "Variant calling for non-model organisms — fastp, BWA-MEM, GATK HaplotypeCaller. oxo-flow port of harvardinformatics/snparcher v2.3.0."
author = "oxo-flow-community"
# Optional per-sample metadata table (TSV/CSV/JSON keyed by sample id, see
# README "Per-sample mark_duplicates override"): a `mark_duplicates` column
# (values true/false) overrides config.mark_duplicates for that sample.
# Unset by default — every sample then follows the global config key.
# metadata_file = "metadata/samples.tsv"

[config]
reference_name = "my_organism"
reference_source = "test/fixtures/ref/genome.fa"
expected_coverage = "low"
ploidy = 2
mark_duplicates = false
intervals_enabled = false
intervals_scatter_count = 50
intervals_db_scatter_factor = 0.15
intervals_min_nmer = 500
intervals_min_contig_length = 0
intervals_db_max_intervals_per_shard = 200
intervals_db_max_contigs_per_shard = 200
# Long-contig (CSI) indexing mode: "auto" (default) decides from the reference
# .fai whether any contig exceeds the TBI limit of 2**29 - 1 (536,870,911) bp
# (upstream common.smk TBI_MAX_CONTIG_LENGTH / _resolve_long_contig_mode);
# true forces long-contig (CSI) mode, false forces short-contig (TBI) mode.
# Long-contig mode emits .csi indexes and keeps GATK consumers on plain VCFs
# (.idx); short mode is byte-identical to a run without this key.
long_contig_mode = "auto"
bcftools_min_mapq = 20
bcftools_min_baseq = 20
bcftools_max_depth = 250
variant_tool = "gatk"
joint_genotyping_enabled = false
generate_filtered_vcf = false
callable_sites_enabled = false
modules_postprocess_enabled = false
modules_qc_enabled = false
gatk_het_prior = 0.005
deepvariant_model_type = "WGS"
# v2.3.0 summed-depth redesign: thresholds come from the cohort's summed-depth
# distribution (clam depths.zarr), not per-sample mosdepth means. min_sample_depth
# is the reads-a-sample-needs-at-a-site cutoff, fraction the fraction of samples
# that must have data at a site; max_depth "auto" is an outlier cutoff on the
# summed depth (robust SDs above its median given by max_depth_k), or a multiple
# of the median (e.g. 1.5). Upstream callable_sites.coverage.* defaults.
callable_sites_min_sample_depth = 1
callable_sites_fraction = 0.25
callable_sites_max_depth = "auto"
callable_sites_max_depth_k = 4
callable_sites_merge_distance = 100
callable_sites_kmer = 150
callable_sites_min_score = 1
postprocess_contig_size = 10000
postprocess_maf = 0.01
postprocess_missingness = 0.75
postprocess_exclude_scaffolds = "mtDNA,Y"
qc_min_depth = 2
qc_max_sample_missingness = 0.49
qc_exclude_scaffolds = ""
qc_clusters = 3
qc_pca_dims = 10
# The Maps/terrain panel of the upstream qc dashboard needs a Google API
# key. Declared sensitive (engine >= 0.17): the value is masked on disk in
# command records, logs, and the checkpoint instead of landing in plaintext
# (lint W032). Provide it at runtime without touching this file:
#   oxo-flow run main.oxoflow modules_qc_enabled=true \
#     --qc_google_api_key "$GOOGLE_MAPS_API_KEY"
qc_google_api_key = { default = "", sensitive = true }
sample_metadata = ""
# Library fan-out dimension (issue #18): comma-separated library/unit ids,
# consumed by the {library} [[values]]-keyed paths and the merge gathers.
# Default "u1" matches the single-library port exactly; multi-library
# cohorts: --arg library_ids=u1,u2 (see [[values]] comment above).
library_ids = "u1"

[defaults]
memory = "8G"

# Sample groups. The default cohort uses local paired FASTQs (input_type
# "fastq"). Rule fan-out is per (rule, group, sample) with wildcard gates on
# `wildcard.input_type`, so a group's input type routes its samples through
# the matching branch. Group names become rule-instance names — keep them
# stable. To add other input types, add groups like:
#
#   # SRA inputs (download_sra -> fastp_srr): accession is required metadata
#   [[sample_groups]]
#   name = "sra"
#   samples = ["my_sra_sample"]
#   metadata = { input_type = "srr", accession = "SRR12345678" }
#
#   # External BAM inputs (stage_external_bam): bam_path is required metadata
#   [[sample_groups]]
#   name = "external"
#   samples = ["my_bam_sample"]
#   metadata = { input_type = "bam", bam_path = "/path/to/sample.bam" }
#
#   # External gVCF inputs (normalize_external_gvcf_for_gatk -> joint
#   # genotyping; requires joint_genotyping_enabled = true):
#   # gvcf_path is required metadata
#   [[sample_groups]]
#   name = "external_gvcfs"
#   samples = ["my_gvcf_sample"]
#   metadata = { input_type = "gvcf", gvcf_path = "/path/to/sample.g.vcf.gz" }
#
# Upstream's sample sheet columns (sample_id, input_type, input, library_id,
# mark_duplicates) map to: sample id = [[sample_groups]] entry, input_type =
# metadata.input_type, input = metadata (accession / bam_path / raw FASTQs),
# library_id = sample id, mark_duplicates = global config, overridable per
# sample via the optional [workflow] metadata_file `mark_duplicates` column
# (see README "Per-sample mark_duplicates override").

[[sample_groups]]
name = "cohort"
samples = ["sample1", "sample2", "sample3"]
metadata = { input_type = "fastq" }

# Library dimension (issue #18): upstream fans out per library_id/input_unit;
# the port collapsed it to one unit (u1). The [[values]] table makes {library}
# an engine fan-out dimension whose value list follows config.library_ids
# (values_from, engine >= 0.17): the single-library default is byte-identical
# to the pre-change port, and multi-library cohorts switch with
# --arg library_ids=u1,u2 (or a profile). The merge chain gathers every
# library's BAM into the per-sample merge.
[[values]]
name = "library"
values = ["u1"]
values_from = "config.library_ids"

# ---------------------------------------------------------------------------
# Reference preparation
# ---------------------------------------------------------------------------

[[rules]]
name = "prepare_reference"
description = "Prepare the reference genome as a bgzip-compressed FASTA"
input = []
output = ["results/reference/{config.reference_name}.fa.gz"]
log = "logs/prepare_reference/{config.reference_name}.txt"
shell = """
if [[ "{config.reference_source}" == *.gz ]]; then
    gunzip -c "{config.reference_source}" | bgzip -c > {output[0]}
else
    bgzip -c "{config.reference_source}" > {output[0]}
fi
"""

[rules.environment]
conda = "envs/reference.yaml"

[[rules]]
name = "index_reference"
description = "Index the reference (samtools faidx/dict, BWA index)"
input = ["results/reference/{config.reference_name}.fa.gz"]
output = [
    "results/reference/{config.reference_name}.fa.gz.gzi",
    "results/reference/{config.reference_name}.fa.gz.fai",
    "results/reference/{config.reference_name}.dict",
    "results/reference/{config.reference_name}.fa.gz.sa",
    "results/reference/{config.reference_name}.fa.gz.pac",
    "results/reference/{config.reference_name}.fa.gz.bwt",
    "results/reference/{config.reference_name}.fa.gz.ann",
    "results/reference/{config.reference_name}.fa.gz.amb",
]
log = "logs/index_reference/{config.reference_name}.txt"
shell = """
samtools faidx {input[0]}
samtools dict {input[0]} -o {output[2]}
bwa index {input[0]}
"""

[rules.environment]
conda = "envs/reference.yaml"

[[rules]]
name = "resolve_long_contig_mode"
description = "Decide long-contig (CSI) vs short-contig (TBI) indexing mode from the reference .fai (upstream common.smk _resolve_long_contig_mode)"
input = ["results/reference/{config.reference_name}.fa.gz.fai"]
output = ["results/reference/{config.reference_name}.contig_mode.txt"]
when = "config.long_contig_mode != false"
log = "logs/resolve_long_contig_mode.txt"
shell = """
: > {log}
rm -f results/reference/.long_contig.flag
LONG=0
if [ "{config.long_contig_mode}" = "true" ]; then
    LONG=1
    echo "mode=explicit-true" >> {log}
else
    MAXLEN=$(awk "{if (\\$2 > m) m = \\$2} END {print m+0}" {input[0]})
    if [ "$MAXLEN" -gt 536870911 ]; then
        LONG=1
    fi
    echo "mode=auto max_contig_length=$MAXLEN" >> {log}
fi
if [ "$LONG" = "1" ]; then
    touch results/reference/.long_contig.flag
    echo "LONG" > {output[0]}
else
    echo "SHORT" > {output[0]}
fi
"""

[rules.environment]
conda = "envs/reference.yaml"

# ---------------------------------------------------------------------------
# Read acquisition and trimming / filtering (fastp)
# ---------------------------------------------------------------------------

[[rules]]
name = "fastp"
description = "Adapter detection and quality filtering of read pairs with fastp (local FASTQ inputs)"
input = [
    "raw/{sample}_1.fastq.gz",
    "raw/{sample}_2.fastq.gz",
]
output = [
    "results/filtered_fastqs/{sample}/{sample}/{library}_1.fastq.gz",
    "results/filtered_fastqs/{sample}/{sample}/{library}_2.fastq.gz",
    "results/fastp/{sample}/{sample}/{library}.json",
]
when = "wildcard.input_type == 'fastq'"
log = "logs/fastp/{sample}.txt"
shell = """
fastp \
    --in1 {input[0]} \
    --in2 {input[1]} \
    --out1 {output[0]} \
    --out2 {output[1]} \
    --thread {threads} \
    --detect_adapter_for_pe \
    -j {output[2]} \
    -h /dev/null
"""
tags = ["qc", "trimming"]

[rules.resources]
threads = 4

[rules.environment]
conda = "envs/fastp.yaml"

[[rules]]
name = "download_sra"
description = "Download SRA run as paired FASTQs (spot-order fasterq-dump, cSRA sam-dump|collate|fastq path, ENA md5-verified fallback)"
output = [
    "results/fastqs/{sample}/{sample}/{library}/{accession}_1.fastq.gz",
    "results/fastqs/{sample}/{sample}/{library}/{accession}_2.fastq.gz",
]
when = "wildcard.input_type == 'srr'"
log = "logs/download_sra/{sample}/{accession}.txt"
shell = """
# This rule pipes, and the default shell does not enable pipefail. Without
# it a failing sam-dump mid-stream still leaves samtools fastq exiting 0, and
# the rule reports success on a truncated FASTQ.
set -o pipefail

OUTDIR=results/fastqs/{sample}/{sample}/{library}
mkdir -p "$OUTDIR"

# Everything this rule downloads or spills lives in one job-private
# directory, removed on exit however the job ends. prefetch previously wrote
# into the working directory, so concurrent jobs shared the accession namespace
# and a sibling's cleanup could delete an in-flight download.
WORK=$(mktemp -d "$OUTDIR/sra_{accession}_work_XXXXXX")
# Extracted and downloaded FASTQs land in OUT, beside the outputs so the
# final move is a rename, and only the declared pair leaves it.
OUT="$OUTDIR/{accession}_extract"
rm -rf "$OUT"
mkdir -p "$OUT"
trap 'rm -rf "$WORK" "$OUT"' EXIT

SEQ=0
ALIGNED=0
EXPECTED=""
EXPECTED_SOURCE=""
# Reads the extractor legitimately leaves outside the pair. Only the aligned
# path produces them, and it sets both from the archive.
EXPECTED_NU=0
EXPECTED_NS=0
ENA_PATH=0

if prefetch --max-size 1T -O "$WORK" {accession} 2>> {log}; then
    # prefetch lays this out as <outdir>/<accession>/<accession>.sra, with any
    # reference object the run needs alongside it. Every extractor below is
    # given the file path, so it never resolves the accession over the network.
    SRA="$WORK/{accession}/{accession}.sra"
    [ -f "$SRA" ] || SRA="$WORK/{accession}/{accession}.sralite"
    if [ ! -f "$SRA" ]; then
        echo "ERROR: {accession}: prefetch exited 0 but no .sra/.sralite is present" \
             "under $WORK. Refusing to fall back to network streaming." >> {log}
        exit 1
    fi

    # Table row counts describing the run's shape: SEQ = spots,
    # PRIM = aligned reads. PRIM selects the extractor below.
    SRA_INFO=$(vdb-dump --info "$SRA" 2>/dev/null)
    echo "$SRA_INFO" | grep -E '^(SEQ|REF|PRIM|SEC) ' >> {log} || true
    SEQ=$(echo "$SRA_INFO" | awk -F: '$1 ~ /^SEQ/ {gsub(/[^0-9]/, "", $2); print $2; exit}')
    PRIM=$(echo "$SRA_INFO" | awk -F: '$1 ~ /^PRIM/ {gsub(/[^0-9]/, "", $2); print $2; exit}')
    SEQ=${SEQ:-0}
    PRIM=${PRIM:-0}

    if [ "$PRIM" -gt 0 ]; then
        ALIGNED=1
        # Reference-aligned (cSRA) submission: reads are stored in reference
        # order, so a spot-ordered extractor (fasterq-dump) random-accesses the
        # whole reference once per read and degrades without bound. sam-dump
        # reads in reference order (sequential); samtools collate restores name
        # grouping and samtools fastq writes the pairs. sam-dump is
        # single-threaded; the remaining threads split between the two
        # samtools stages.
        SAMTOOLS_THREADS=$(( ({threads} - 1) / 2 ))
        [ "$SAMTOOLS_THREADS" -lt 0 ] && SAMTOOLS_THREADS=0

        # 2 x SEQ is not what this pipe emits: secondary-only reads surface as
        # singletons and mate-less records as unpaired. Both are properties of
        # the archive, so predict them from the SEQUENCE table before extracting
        # (see scripts/csra_expected_reads.awk) and fail on unmodelled layouts.
        if ! vdb-dump -T SEQUENCE -C READ_LEN,PRIMARY_ALIGNMENT_ID,ALIGNMENT_COUNT \
                -f tab "$SRA" 2>> {log} \
            | awk -f scripts/csra_expected_reads.awk > "$WORK/census.txt"; then
            echo "ERROR: {accession}: could not read the SEQUENCE table to predict" \
                 "what sam-dump will emit." >> {log}
            exit 1
        fi
        sed 's/^/census: /' "$WORK/census.txt" >> {log}
        # The census must describe the same run vdb-dump --info did; a
        # disagreement means the table was misread, not that reads are missing.
        if [ "$(sed -n 's|^spots=||p' "$WORK/census.txt")" != "$SEQ" ] \
           || [ "$(sed -n 's|^reads_primary=||p' "$WORK/census.txt")" != "$PRIM" ]; then
            echo "ERROR: {accession}: the census saw $(sed -n 's|^spots=||p' "$WORK/census.txt")" \
                 "spots and $(sed -n 's|^reads_primary=||p' "$WORK/census.txt") primary" \
                 "alignments; the run reports SEQ=$SEQ and PRIM=$PRIM." >> {log}
            exit 1
        fi
        if [ "$(sed -n 's|^spots_unmodelled=||p' "$WORK/census.txt")" != 0 ] \
           || [ "$(sed -n 's|^lines_malformed=||p' "$WORK/census.txt")" != 0 ]; then
            echo "ERROR: {accession}: $(sed -n 's|^spots_unmodelled=||p' "$WORK/census.txt")" \
                 "spots do not hold exactly two reads" \
                 "($(sed -n 's|^lines_malformed=||p' "$WORK/census.txt") unparseable), so what" \
                 "sam-dump emits for them cannot be predicted." >> {log}
            exit 1
        fi

        # -F 0x900 removes only secondary/supplementary copies, so every read
        # the census predicts must arrive exactly once. collate gets -u: without
        # it, collate recompresses what samtools fastq would immediately
        # decompress again. A failure anywhere in the pipe already ends the job
        # through pipefail; testing it here only puts the cause in the log.
        if ! sam-dump -u "$SRA" 2>> {log} \
                | samtools collate -u -O -@ "$SAMTOOLS_THREADS" - "$WORK/collate" 2>> {log} \
                | samtools fastq -F 0x900 -@ "$SAMTOOLS_THREADS" \
                    -1 {output[0]} \
                    -2 {output[1]} \
                    -0 "$WORK/unpaired.fastq.gz" \
                    -s "$WORK/singleton.fastq.gz" \
                    - 2>> {log}; then
            echo "ERROR: {accession}: the sam-dump | collate | fastq pipe failed, so the" \
                 "FASTQs are incomplete." >> {log}
            exit 1
        fi

        EXPECTED_NS=$(sed -n 's|^singletons=||p' "$WORK/census.txt")
        EXPECTED_NU=$(sed -n 's|^unpaired=||p' "$WORK/census.txt")
        EXPECTED=$(( 2 * $(sed -n 's|^pairs=||p' "$WORK/census.txt") + EXPECTED_NS + EXPECTED_NU ))
        EXPECTED_SOURCE="archive census"
    else
        # No alignment table: no reference to walk, so fasterq-dump's
        # multi-threaded read of the SEQUENCE table is the right access pattern
        # and sam-dump has no advantage. tee keeps fasterq-dump's messages in
        # the log even when it fails and the trap removes WORK.
        mkdir -p "$WORK/fasterq"
        fasterq-dump "$SRA" \
            -O "$OUT" \
            -e {threads} \
            -t "$WORK/fasterq" \
            2>&1 | tee "$WORK/fasterq-dump.log" >> {log}
        pigz -p {threads} "$OUT"/{accession}*.fastq

        # 2 x SEQ is not the right expectation here: fasterq-dump drops
        # technical and zero-length reads, and a spot need not hold two
        # biological reads. Use the count the tool reports.
        EXPECTED=$(awk -F: '/reads written/ {gsub(/[^0-9]/, "", $2); print $2; exit}' \
            "$WORK/fasterq-dump.log")
        EXPECTED_SOURCE="fasterq-dump reads-written"
    fi
else
    # prefetch can fail for a single run (NCBI "file unauthorized") while other
    # runs in the project succeed, so this path must not be gated on something
    # it cannot produce. ENA publishes an md5 per file, a stronger completeness
    # check than a count: it catches truncation and corruption exactly.
    ENA_PATH=1
    echo "Prefetch failed, trying ENA via ffq..." >> {log}

    # Land the file list before looping: a pipeline-fed loop runs in a
    # subshell, where a failure cannot stop the rule.
    ffq --ftp {accession} 2>> {log} \
        | jq -r '.[] | .url + " " + (.md5 // "")' \
        > "$WORK/ena_files.txt"

    ENA_FILES=0
    ENA_NO_MD5=0
    while read -r url md5; do
        [[ -n "$url" ]] || continue
        dest="$OUT/$(basename "$url")"
        echo "Downloading: $url" >> {log}
        if ! curl -fSL "$url" -o "$dest" >> {log} 2>&1; then
            echo "ERROR: {accession}: download failed for $url" >> {log}
            exit 1
        fi
        ENA_FILES=$(( ENA_FILES + 1 ))
        if [ -n "$md5" ]; then
            if echo "$md5  $dest" | md5sum -c - >> {log} 2>&1; then
                echo "md5 verified: $dest" >> {log}
            else
                echo "ERROR: {accession}: md5 mismatch for $dest; the download is" \
                     "corrupt or truncated." >> {log}
                exit 1
            fi
        else
            ENA_NO_MD5=$(( ENA_NO_MD5 + 1 ))
        fi
    done < "$WORK/ena_files.txt"

    if [ "$ENA_FILES" -eq 0 ]; then
        echo "ERROR: {accession}: prefetch failed and ffq returned no ENA files, so" \
             "there is nothing to download." >> {log}
        exit 1
    fi
    if [ "$ENA_NO_MD5" -ne 0 ]; then
        echo "WARNING: {accession}: $ENA_NO_MD5 of $ENA_FILES ENA files carried no" \
             "md5, so their integrity is unverified." >> {log}
    fi
fi

# Move the pair into place; the aligned path already wrote it there. A missing
# mate is reported by the empty-output check below.
if [ "$ALIGNED" -eq 0 ]; then
    [ ! -f "$OUT/{accession}_1.fastq.gz" ] || mv "$OUT/{accession}_1.fastq.gz" {output[0]}
    [ ! -f "$OUT/{accession}_2.fastq.gz" ] || mv "$OUT/{accession}_2.fastq.gz" {output[1]}
fi

# The previous test only asked whether the output files exist. That passes
# for a pigz that compressed nothing, a wall-killed extractor, and silent
# read loss -- all of which have happened on this rule.
N1=$(if [ -s "{output[0]}" ]; then pigz -dc "{output[0]}" | wc -l | awk '{print int($1 / 4)}'; else echo 0; fi)
N2=$(if [ -s "{output[1]}" ]; then pigz -dc "{output[1]}" | wc -l | awk '{print int($1 / 4)}'; else echo 0; fi)
NORPHAN=$(if [ -s "$OUT/{accession}.fastq.gz" ]; then pigz -dc "$OUT/{accession}.fastq.gz" | wc -l | awk '{print int($1 / 4)}'; else echo 0; fi)
NU=$(if [ -s "$WORK/unpaired.fastq.gz" ]; then pigz -dc "$WORK/unpaired.fastq.gz" | wc -l | awk '{print int($1 / 4)}'; else echo 0; fi)
NS=$(if [ -s "$WORK/singleton.fastq.gz" ]; then pigz -dc "$WORK/singleton.fastq.gz" | wc -l | awk '{print int($1 / 4)}'; else echo 0; fi)
echo "emitted: r1=$N1 r2=$N2 orphan=$NORPHAN unpaired=$NU singleton=$NS" >> {log}

if [ "$N1" -eq 0 ] || [ "$N2" -eq 0 ]; then
    echo "ERROR: {accession}: empty FASTQ output (r1=$N1 r2=$N2)" >> {log}
    exit 1
fi
if [ "$N1" -ne "$N2" ]; then
    echo "ERROR: {accession}: mate files disagree (r1=$N1 r2=$N2)" >> {log}
    exit 1
fi

# Every read the extractor produced must reach the output files. Both paths
# check this; they differ only in what the expected count is, because each
# extractor decides for itself which stored reads to emit.
TOTAL=$(( N1 + N2 + NORPHAN + NU + NS ))
echo "completeness: emitted=$TOTAL expected=${EXPECTED:-unknown} (${EXPECTED_SOURCE:-none})" >> {log}

if [ -n "$EXPECTED" ]; then
    if [ "$TOTAL" -ne "$EXPECTED" ]; then
        echo "ERROR: {accession}: emitted $TOTAL reads, expected $EXPECTED" \
             "($EXPECTED_SOURCE). Reads were lost or duplicated." >> {log}
        exit 1
    fi
elif [ "$ENA_PATH" -eq 1 ]; then
    # Files came from ENA rather than an extractor, so there is no read count
    # to compare against; completeness was established by the md5 check, which
    # already exited on mismatch.
    echo "completeness: established by ENA md5, not by read count" >> {log}
else
    echo "ERROR: {accession}: could not determine the expected read count, so" \
         "completeness cannot be checked. The extractor probably did not run to" \
         "completion; see the log above." >> {log}
    exit 1
fi

if [ "$ALIGNED" -eq 1 ]; then
    # The total above cannot tell a split pair from two singletons, so any
    # surplus in -0/-s beyond the archive's prediction means collate failed to
    # pair mates as stored.
    if [ "$NU" -ne "$EXPECTED_NU" ] || [ "$NS" -ne "$EXPECTED_NS" ]; then
        echo "ERROR: {accession}: $NU unpaired and $NS singleton reads were extracted;" \
             "the archive predicts $EXPECTED_NU and $EXPECTED_NS, so mates were not" \
             "paired as stored." >> {log}
        exit 1
    fi
    echo "discarded: $NS singleton reads (mate stored only as a secondary alignment)" \
         "and $NU unpaired reads (the spot's other read is zero-length); r1/r2 carry" \
         "every complete pair." >> {log}
fi
"""
tags = ["read-acquisition"]

[rules.resources]
threads = 4

[rules.environment]
conda = "envs/sra.yaml"

[[rules]]
name = "fastp_srr"
description = "Adapter detection and quality filtering of downloaded SRA read pairs with fastp"
input = [
    "results/fastqs/{sample}/{sample}/{library}/{accession}_1.fastq.gz",
    "results/fastqs/{sample}/{sample}/{library}/{accession}_2.fastq.gz",
]
output = [
    "results/filtered_fastqs/{sample}/{sample}/{library}_1.fastq.gz",
    "results/filtered_fastqs/{sample}/{sample}/{library}_2.fastq.gz",
    "results/fastp/{sample}/{sample}/{library}.json",
]
when = "wildcard.input_type == 'srr'"
log = "logs/fastp_srr/{sample}.txt"
shell = """
fastp \
    --in1 {input[0]} \
    --in2 {input[1]} \
    --out1 {output[0]} \
    --out2 {output[1]} \
    --thread {threads} \
    --detect_adapter_for_pe \
    -j {output[2]} \
    -h /dev/null
"""
tags = ["qc", "trimming"]

[rules.resources]
threads = 4

[rules.environment]
conda = "envs/fastp.yaml"

# ---------------------------------------------------------------------------
# Alignment (BWA-MEM) and BAM merging
# ---------------------------------------------------------------------------

[[rules]]
name = "bwa_mem"
description = "Align reads with bwa mem and sort with samtools"
input = [
    "results/filtered_fastqs/{sample}/{sample}/{library}_1.fastq.gz",
    "results/filtered_fastqs/{sample}/{sample}/{library}_2.fastq.gz",
    "results/reference/{config.reference_name}.fa.gz",
    "results/reference/{config.reference_name}.fa.gz.fai",
    "results/reference/{config.reference_name}.dict",
]
when = "(wildcard.input_type == 'fastq' || wildcard.input_type == 'srr')"
output = ["results/bams/raw/{sample}/{sample}/{library}.bam"]
temp_output = ["results/bams/raw/{sample}/{sample}/{library}.bam"]
log = "logs/bwa_mem/{sample}.txt"
shell = """
bwa mem -M -t {threads} -R "@RG\\tID:{sample}.{library}\\tSM:{sample}\\tLB:{sample}\\tPL:ILLUMINA" \
    {input[2]} {input[0]} {input[1]} | samtools sort -o {output[0]} -
"""
tags = ["alignment"]

[rules.resources]
threads = 8

[rules.environment]
conda = "envs/samtools.yaml"

[[rules]]
name = "merge_library_bams"
description = "Merge a library's per-unit BAMs into the per-library BAM (upstream samtools merge per library_id; v1: one unit per library, so the merge is the unit-to-library promotion)"
input = ["results/bams/raw/{sample}/{sample}/{library}.bam"]
when = "(wildcard.input_type == 'fastq' || wildcard.input_type == 'srr')"
output = ["results/bams/library/{sample}/{sample}/{library}.bam"]
temp_output = ["results/bams/library/{sample}/{sample}/{library}.bam"]
log = "logs/merge_library_bams/{sample}_{library}.txt"
shell = "samtools merge -f {output[0]} {input[0]}"
tags = ["alignment"]

[rules.environment]
conda = "envs/samtools.yaml"

[[rules]]
name = "merge_library_level_bams"
description = "Merge per-library BAMs into the final sample BAM (no duplicate marking; gathers every {library})"
expand_inputs = [
    { pattern = "results/bams/library/{sample}/{sample}/{library}.bam", variables = { library = "config.library_ids" } }
]
when = "(!config.mark_duplicates || {meta.mark_duplicates} == 'false') && {meta.mark_duplicates} != 'true' && (wildcard.input_type == 'fastq' || wildcard.input_type == 'srr')"
output = ["results/bams/merged/{sample}.bam"]
log = "logs/merge_library_level_bams/{sample}.txt"
shell = "samtools merge -f {output[0]} {input}"
tags = ["alignment"]

[rules.environment]
conda = "envs/samtools.yaml"

[[rules]]
name = "markdup_library"
description = "Mark duplicate reads per library with sambamba (upstream default branch)"
input = ["results/bams/library/{sample}/{sample}/{library}.bam"]
when = "(config.mark_duplicates || {meta.mark_duplicates} == 'true') && {meta.mark_duplicates} != 'false' && (wildcard.input_type == 'fastq' || wildcard.input_type == 'srr')"
output = ["results/bams/library_markdup/{sample}/{sample}/{library}.bam"]
temp_output = ["results/bams/library_markdup/{sample}/{sample}/{library}.bam"]
log = "logs/markdup/{sample}.txt"
shell = """
sambamba markdup -t {threads} {input[0]} {output[0]} 2> {log}
rm -f {output[0]}.bai
"""
tags = ["alignment"]

[rules.resources]
threads = 4

[rules.environment]
conda = "envs/sambamba.yaml"

[[rules]]
name = "merge_dedup_libraries"
description = "Merge duplicate-marked library BAMs into the final sample BAM (gathers every {library}; upstream samtools merge across library_id)"
expand_inputs = [
    { pattern = "results/bams/library_markdup/{sample}/{sample}/{library}.bam", variables = { library = "config.library_ids" } }
]
when = "(config.mark_duplicates || {meta.mark_duplicates} == 'true') && {meta.mark_duplicates} != 'false' && (wildcard.input_type == 'fastq' || wildcard.input_type == 'srr')"
output = ["results/bams/markdup/{sample}.bam"]
log = "logs/merge_dedup_libraries/{sample}.txt"
shell = "samtools merge -f {output[0]} {input}"
tags = ["alignment"]

[rules.environment]
conda = "envs/samtools.yaml"

[[rules]]
name = "stage_external_bam"
description = "Stage an external BAM input as a symlink into the workflow's BAM tree"
input = ["{bam_path}"]
when = "wildcard.input_type == 'bam'"
output = ["results/bams/input/{sample}.bam"]
log = "logs/stage_external_bam/{sample}.txt"
shell = "ln -sf {input[0]} {output[0]} 2> {log}"
tags = ["alignment"]

[[rules]]
name = "index_bam_csi"
description = "Index the final BAM with CSI (required by GATK)"
input = ["results/bams/merged/{sample}.bam"]
when = "(!config.mark_duplicates || {meta.mark_duplicates} == 'false') && {meta.mark_duplicates} != 'true' && (wildcard.input_type == 'fastq' || wildcard.input_type == 'srr')"
output = ["results/bams/merged/{sample}.bam.csi"]
log = "logs/index_bam_csi/{sample}.txt"
shell = "samtools index -c {input[0]} {output[0]}"
tags = ["alignment"]

[rules.environment]
conda = "envs/samtools.yaml"

[[rules]]
name = "index_bam_csi_markdup"
description = "Index the duplicate-marked final BAM with CSI"
input = ["results/bams/markdup/{sample}.bam"]
when = "(config.mark_duplicates || {meta.mark_duplicates} == 'true') && {meta.mark_duplicates} != 'false' && (wildcard.input_type == 'fastq' || wildcard.input_type == 'srr')"
output = ["results/bams/markdup/{sample}.bam.csi"]
log = "logs/index_bam_csi_markdup/{sample}.txt"
shell = "samtools index -c {input[0]} {output[0]}"
tags = ["alignment"]

[rules.environment]
conda = "envs/samtools.yaml"

[[rules]]
name = "index_bam_csi_external"
description = "Index the staged external BAM with CSI"
input = ["results/bams/input/{sample}.bam"]
when = "wildcard.input_type == 'bam'"
output = ["results/bams/input/{sample}.bam.csi"]
log = "logs/index_bam_csi_external/{sample}.txt"
shell = "samtools index -c {input[0]} {output[0]}"
tags = ["alignment"]

[rules.environment]
conda = "envs/samtools.yaml"

[[rules]]
name = "normalize_external_gvcf_for_gatk"
description = "Normalize an external gVCF input (recompress + tabix index) for joint genotyping"
input = ["{gvcf_path}"]
when = "wildcard.input_type == 'gvcf' && (!file_exists(\"results/reference/.long_contig.flag\") || config.long_contig_mode == false)"
output = [
    "results/gvcfs/{sample}.g.vcf.gz",
    "results/gvcfs/{sample}.g.vcf.gz.tbi",
]
log = "logs/normalize_external_gvcf_for_gatk/{sample}.txt"
shell = """
bcftools view -Oz -o {output[0]} {input[0]} 2> {log}
bcftools index -t {output[0]} 2>> {log}
"""
tags = ["variant-calling"]

[rules.environment]
conda = "envs/bcftools.yaml"

[[rules]]
name = "normalize_external_gvcf_for_gatk_long"
description = "Normalize an external gVCF for joint genotyping (long-contig CSI; plain work .vcf + GATK .idx for GATK, compressed CSI archive for the gVCF deliverable)"
input = ["{gvcf_path}"]
when = "wildcard.input_type == 'gvcf' && file_exists(\"results/reference/.long_contig.flag\") && config.long_contig_mode != false"
output = [
    "results/gvcfs/work/{sample}.g.vcf",
    "results/gvcfs/work/{sample}.g.vcf.idx",
    "results/gvcfs/{sample}.g.vcf.gz",
    "results/gvcfs/{sample}.g.vcf.gz.csi",
]
temp_output = [
    "results/gvcfs/work/{sample}.g.vcf",
    "results/gvcfs/work/{sample}.g.vcf.idx",
]
depends_on = ["resolve_long_contig_mode"]
log = "logs/normalize_external_gvcf_for_gatk_long/{sample}.txt"
shell = """
# GATK reads the plain work VCF (its .idx is GATK-written by
# IndexFeatureFile); the .gz + CSI pair is the durable deliverable. Upstream
# keeps the external work file under results/gvcfs/work/external/ and
# archives nothing for gVCF samples; the port shares the work path with the
# regular samples (input_type is single-valued per sample, so the paths are
# disjoint by sample) and adds the archive to keep the port's gVCF
# deliverable complete (deviation: see README).
bcftools view -O v -o {output[0]} {input[0]} 2> {log}
gatk IndexFeatureFile -I {output[0]} 2>> {log}
bcftools view -O z -o {output[2]} {input[0]} 2>> {log}
bcftools index -f -c {output[2]} 2>> {log}
"""
tags = ["variant-calling"]

[rules.environment]
conda = "envs/gatk.yaml"

# ---------------------------------------------------------------------------
# Interval scatter (GATK, gated by intervals_enabled)
#
# Port of upstream's checkpoint-based interval fan-out (workflow/rules/
# intervals.smk:59,89 + variant_calling/gatk_intervals.smk) on the engine's
# output_pattern primitive: SplitIntervals output names are unknown until the
# run, so the splitter is an output_pattern producer and every per-interval
# rule below is a deferred consumer instantiated once per discovered file.
#
# Upstream splits ONCE per cohort; oxo-flow's output_pattern domain carries
# the instance bindings of its producer, so the gVCF splitter fans out per
# sample to give the per-(sample, interval) HaplotypeCaller instances their
# sample dimension. SplitIntervals is deterministic, so every sample gets an
# identical copy of the interval set (deviation: N-1 redundant tiny runs).
# The DB splitter stays cohort-level (its consumers are per-interval, not
# per-sample) and uses a separate wildcard {db_interval}: one fresh wildcard
# may have only one producer (v1).
# ---------------------------------------------------------------------------

[[rules]]
name = "picard_intervals"
description = "Split the reference into N-mers with picard ScatterIntervalsByNs (interval mode)"
input = [
    "results/reference/{config.reference_name}.fa.gz",
    "results/reference/{config.reference_name}.fa.gz.fai",
    "results/reference/{config.reference_name}.dict",
]
when = "config.intervals_enabled && config.variant_tool == 'gatk'"
output = ["results/intervals/picard.interval_list"]
log = "logs/intervals_picard.txt"
shell = """
picard ScatterIntervalsByNs \
    -Xmx7000m \
    REFERENCE={input[0]} \
    OUTPUT={output[0]} \
    MAX_TO_MERGE={config.intervals_min_nmer} \
    OUTPUT_TYPE=ACGT \
    &> {log}
"""
tags = ["variant-calling"]

[rules.resources]
threads = 1

[rules.environment]
conda = "envs/gatk.yaml"

[[rules]]
name = "filter_picard_intervals"
description = "Drop intervals on contigs shorter than the configured minimum (interval mode)"
input = ["results/intervals/picard.interval_list"]
when = "config.intervals_enabled && config.variant_tool == 'gatk'"
output = ["results/intervals/filtered.interval_list"]
log = "logs/intervals_filter.txt"
script = "python scripts/interval_list_tools.py filter --input {input[0]} --output {output[0]} --min-contig-length {config.intervals_min_contig_length} &> {log}"
tags = ["variant-calling"]

[rules.resources]
threads = 1

[rules.environment]
conda = "envs/gatk.yaml"

[[rules]]
name = "create_gvcf_intervals"
description = "Split the filtered interval list into scatter intervals (gVCF mode, output_pattern producer)"
input = [
    "results/intervals/filtered.interval_list",
    "results/reference/{config.reference_name}.fa.gz",
    "results/reference/{config.reference_name}.fa.gz.fai",
    "results/reference/{config.reference_name}.dict",
]
when = "config.intervals_enabled && config.variant_tool == 'gatk' && wildcard.input_type != 'gvcf'"
output_pattern = "results/intervals/gvcf/{sample}/{interval}-scattered.interval_list"
log = "logs/create_gvcf_intervals/{sample}.txt"
shell = """
mkdir -p results/intervals/gvcf/{sample}
gatk SplitIntervals \
    --java-options '-Xmx7000m' \
    -R {input[1]} \
    -L {input[0]} \
    -O results/intervals/gvcf/{sample} \
    --scatter-count {config.intervals_scatter_count} \
    --subdivision-mode BALANCING_WITHOUT_INTERVAL_SUBDIVISION \
    --interval-merging-rule OVERLAPPING_ONLY \
    &> {log}
ls -1 results/intervals/gvcf/{sample}/*-scattered.interval_list > results/intervals/gvcf/{sample}/intervals.txt
"""
tags = ["variant-calling"]

[rules.resources]
threads = 1

[rules.environment]
conda = "envs/gatk.yaml"

[[rules]]
name = "gatk_haplotypecaller_interval"
description = "Per-interval HaplotypeCaller to gVCF (interval mode, no-markdup BAM)"
input = [
    "results/bams/merged/{sample}.bam",
    "results/bams/merged/{sample}.bam.csi",
    "results/reference/{config.reference_name}.fa.gz",
    "results/reference/{config.reference_name}.fa.gz.fai",
    "results/reference/{config.reference_name}.dict",
    "results/intervals/gvcf/{sample}/{interval}-scattered.interval_list",
]
when = "config.intervals_enabled && config.variant_tool == 'gatk' && (!config.mark_duplicates || {meta.mark_duplicates} == 'false') && {meta.mark_duplicates} != 'true' && (wildcard.input_type == 'fastq' || wildcard.input_type == 'srr') && (!file_exists(\"results/reference/.long_contig.flag\") || config.long_contig_mode == false)"
output = [
    "results/interval_gvcfs/{sample}/{interval}.g.vcf.gz",
    "results/interval_gvcfs/{sample}/{interval}.g.vcf.gz.tbi",
]
log = "logs/gatk_haplotypecaller_interval/{sample}/{interval}.txt"
shell = """
# Upstream HC_MIN_PRUNING/HC_MIN_DANGLING (v2.3.0): low-coverage cohorts call
# at 1/1, otherwise GATK's defaults 2/4.
HC_PRUNE=1
HC_DANGLING=1
if [ "{config.expected_coverage}" != "low" ]; then HC_PRUNE=2; HC_DANGLING=4; fi
gatk HaplotypeCaller \
    --java-options '-Xmx7000m' \
    -R {input[2]} \
    -I {input[0]} \
    --read-index {input[1]} \
    -L {input[5]} \
    -O {output[0]} \
    -ploidy {config.ploidy} \
    --native-pair-hmm-threads {threads} \
    --emit-ref-confidence GVCF \
    --min-pruning "$HC_PRUNE" \
    --min-dangling-branch-length "$HC_DANGLING"
"""
tags = ["variant-calling"]

[rules.resources]
threads = 1

[rules.environment]
conda = "envs/gatk.yaml"

[[rules]]
name = "gatk_haplotypecaller_interval_long"
description = "Per-interval HaplotypeCaller to gVCF (interval mode, long-contig CSI, no-markdup BAM)"
input = [
    "results/bams/merged/{sample}.bam",
    "results/bams/merged/{sample}.bam.csi",
    "results/reference/{config.reference_name}.fa.gz",
    "results/reference/{config.reference_name}.fa.gz.fai",
    "results/reference/{config.reference_name}.dict",
    "results/intervals/gvcf/{sample}/{interval}-scattered.interval_list",
]
when = "config.intervals_enabled && config.variant_tool == 'gatk' && (!config.mark_duplicates || {meta.mark_duplicates} == 'false') && {meta.mark_duplicates} != 'true' && (wildcard.input_type == 'fastq' || wildcard.input_type == 'srr') && file_exists(\"results/reference/.long_contig.flag\") && config.long_contig_mode != false"
output = [
    "results/interval_gvcfs/{sample}/{interval}.g.vcf",
]
depends_on = ["resolve_long_contig_mode"]
log = "logs/gatk_haplotypecaller_interval_long/{sample}/{interval}.txt"
shell = """
# Upstream HC_MIN_PRUNING/HC_MIN_DANGLING (v2.3.0): low-coverage cohorts call
# at 1/1, otherwise GATK's defaults 2/4.
HC_PRUNE=1
HC_DANGLING=1
if [ "{config.expected_coverage}" != "low" ]; then HC_PRUNE=2; HC_DANGLING=4; fi
gatk HaplotypeCaller \
    --java-options '-Xmx7000m' \
    -R {input[2]} \
    -I {input[0]} \
    --read-index {input[1]} \
    -L {input[5]} \
    -O {output[0]} \
    -ploidy {config.ploidy} \
    --native-pair-hmm-threads {threads} \
    --emit-ref-confidence GVCF \
    --min-pruning "$HC_PRUNE" \
    --min-dangling-branch-length "$HC_DANGLING"
"""
tags = ["variant-calling"]

[rules.resources]
threads = 1

[rules.environment]
conda = "envs/gatk.yaml"

[[rules]]
name = "gatk_haplotypecaller_interval_markdup"
description = "Per-interval HaplotypeCaller to gVCF (interval mode, duplicate-marked BAM)"
input = [
    "results/bams/markdup/{sample}.bam",
    "results/bams/markdup/{sample}.bam.csi",
    "results/reference/{config.reference_name}.fa.gz",
    "results/reference/{config.reference_name}.fa.gz.fai",
    "results/reference/{config.reference_name}.dict",
    "results/intervals/gvcf/{sample}/{interval}-scattered.interval_list",
]
when = "config.intervals_enabled && config.variant_tool == 'gatk' && (config.mark_duplicates || {meta.mark_duplicates} == 'true') && {meta.mark_duplicates} != 'false' && (wildcard.input_type == 'fastq' || wildcard.input_type == 'srr') && (!file_exists(\"results/reference/.long_contig.flag\") || config.long_contig_mode == false)"
output = [
