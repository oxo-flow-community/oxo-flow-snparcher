[[rules]]
name = "deepvariant_call"
description = "Per-sample variant calling to gVCF with DeepVariant (docker, no-markdup BAM)"
input = [
    "results/bams/merged/{sample}.bam",
    "results/bams/merged/{sample}.bam.csi",
    "results/reference/{config.reference_name}.fa.gz",
    "results/reference/{config.reference_name}.fa.gz.fai",
    "results/reference/{config.reference_name}.dict",
]
when = "config.variant_tool == 'deepvariant' && !config.mark_duplicates && (wildcard.input_type == 'fastq' || wildcard.input_type == 'srr')"
output = [
    "results/gvcfs/{sample}.g.vcf.gz",
    "results/gvcfs/{sample}.g.vcf.gz.tbi",
    "results/deepvariant/{sample}.vcf.gz",
    "results/deepvariant/{sample}.vcf.gz.tbi",
]
temp_output = [
    "results/deepvariant/{sample}.vcf.gz",
    "results/deepvariant/{sample}.vcf.gz.tbi",
]
