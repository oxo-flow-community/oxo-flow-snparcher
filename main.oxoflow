bcftools index -f -c {output[0]} 2>> {log}
"""
tags = ["variant-calling"]

[rules.environment]
conda = "envs/bcftools.yaml"

[[rules]]
name = "deepvariant_call"
description = "Per-sample variant calling to gVCF with DeepVariant (docker, no-markdup BAM)"
input = [
    "results/bams/merged/{sample}.bam",
    "results/bams/merged/{sample}.bam.csi",
    "results/reference/{config.reference_name}.fa.gz",
    "results/reference/{config.reference_name}.fa.gz.fai",
    "results/reference/{config.reference_name}.dict",
]
when = "config.variant_tool == 'deepvariant' && (!config.mark_duplicates || {meta.mark_duplicates} == 'false') && {meta.mark_duplicates} != 'true' && (wildcard.input_type == 'fastq' || wildcard.input_type == 'srr') && (!file_exists(\"results/reference/.long_contig.flag\") || config.long_contig_mode == false)"
output = [
    "results/gvcfs/{sample}.g.vcf.gz",
    "results/gvcfs/{sample}.g.vcf.gz.tbi",
    "results/deepvariant/{sample}.vcf.gz",
    "results/deepvariant/{sample}.vcf.gz.tbi",
]
temp_output = [
    "results/deepvariant/{sample}.vcf.gz",
    "results/deepvariant/{sample}.vcf.gz.tbi",
]
log = "logs/deepvariant_call/{sample}.txt"
shell = """
# Intermediate tfrecords can take tens of GB per sample. Keep them in a
# private directory under the working directory (which the container runtime
# binds; a custom tmpdir may not be), and remove it when the job ends
# (v2.3.0 WORK-dir fix).
WORK=$(mktemp -d "results/deepvariant/{sample}.XXXXXX")
trap 'rm -rf "$WORK";' EXIT
# --sample_name overrides the BAM's read-group SM, which GLnexus would
# otherwise use for the sample's column (v2.3.0).
/opt/deepvariant/bin/run_deepvariant \
    --ref {input[2]} \
    --reads {input[0]} \
    --sample_name {sample} \
    --output_vcf {output[2]} \
    --output_gvcf {output[0]} \
    --model_type {config.deepvariant_model_type} \
    --num_shards {threads} \
    --intermediate_results_dir "$WORK" \
    &> {log}
"""
tags = ["variant-calling"]

[rules.resources]
threads = 8

[rules.environment]
docker = "google/deepvariant:1.10.0"

[[rules]]
name = "deepvariant_call_markdup"
description = "Per-sample variant calling to gVCF with DeepVariant (docker, duplicate-marked BAM)"
