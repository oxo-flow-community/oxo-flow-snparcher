[rules.environment]
conda = "envs/gatk.yaml"

[[rules]]
name = "gatk_haplotypecaller_interval_external"
description = "Per-interval HaplotypeCaller to gVCF (interval mode, staged external BAM)"
input = [
    "results/bams/input/{sample}.bam",
    "results/bams/input/{sample}.bam.csi",
    "results/reference/{config.reference_name}.fa.gz",
    "results/reference/{config.reference_name}.fa.gz.fai",
    "results/reference/{config.reference_name}.dict",
    "results/intervals/gvcf/{sample}/{interval}-scattered.interval_list",
]
when = "config.intervals_enabled && config.variant_tool == 'gatk' && wildcard.input_type == 'bam' && (!file_exists(\"results/reference/.long_contig.flag\") || config.long_contig_mode == false)"
output = [
    "results/interval_gvcfs/{sample}/{interval}.g.vcf.gz",
    "results/interval_gvcfs/{sample}/{interval}.g.vcf.gz.tbi",
]
log = "logs/gatk_haplotypecaller_interval_external/{sample}/{interval}.txt"
shell = """
# Upstream HC_MIN_PRUNING/HC_MIN_DANGLING (v2.3.0): low-coverage cohorts call
# at 1/1, otherwise GATK's defaults 2/4.
HC_PRUNE=1
HC_DANGLING=1
if [ "{config.expected_coverage}" != "low" ]; then HC_PRUNE=2; HC_DANGLING=4; fi
gatk HaplotypeCaller \
    --java-options '-Xmx7000m' \
    -R {input[2]} \
    -I {input[0]} \
    --read-index {input[1]} \
    -L {input[5]} \
    -O {output[0]} \
    -ploidy {config.ploidy} \
    --native-pair-hmm-threads {threads} \
    --emit-ref-confidence GVCF \
    --min-pruning "$HC_PRUNE" \
    --min-dangling-branch-length "$HC_DANGLING"
"""
tags = ["variant-calling"]

[rules.resources]
threads = 1

[rules.environment]
conda = "envs/gatk.yaml"

[[rules]]
name = "gatk_haplotypecaller_interval_external_long"
description = "Per-interval HaplotypeCaller to gVCF (interval mode, long-contig CSI, staged external BAM)"
input = [
    "results/bams/input/{sample}.bam",
    "results/bams/input/{sample}.bam.csi",
    "results/reference/{config.reference_name}.fa.gz",
    "results/reference/{config.reference_name}.fa.gz.fai",
    "results/reference/{config.reference_name}.dict",
    "results/intervals/gvcf/{sample}/{interval}-scattered.interval_list",
]
when = "config.intervals_enabled && config.variant_tool == 'gatk' && wildcard.input_type == 'bam' && file_exists(\"results/reference/.long_contig.flag\") && config.long_contig_mode != false"
output = [
    "results/interval_gvcfs/{sample}/{interval}.g.vcf",
]
depends_on = ["resolve_long_contig_mode"]
log = "logs/gatk_haplotypecaller_interval_external_long/{sample}/{interval}.txt"
shell = """
# Upstream HC_MIN_PRUNING/HC_MIN_DANGLING (v2.3.0): low-coverage cohorts call
# at 1/1, otherwise GATK's defaults 2/4.
HC_PRUNE=1
HC_DANGLING=1
if [ "{config.expected_coverage}" != "low" ]; then HC_PRUNE=2; HC_DANGLING=4; fi
gatk HaplotypeCaller \
    --java-options '-Xmx7000m' \
    -R {input[2]} \
    -I {input[0]} \
    --read-index {input[1]} \
    -L {input[5]} \
    -O {output[0]} \
    -ploidy {config.ploidy} \
    --native-pair-hmm-threads {threads} \
    --emit-ref-confidence GVCF \
    --min-pruning "$HC_PRUNE" \
    --min-dangling-branch-length "$HC_DANGLING"
"""
tags = ["variant-calling"]

[rules.resources]
threads = 1

[rules.environment]
conda = "envs/gatk.yaml"

[[rules]]
name = "concat_interval_gvcfs"
description = "Merge per-interval gVCFs into the per-sample gVCF (interval mode)"
input = ["results/interval_gvcfs/{sample}/*.g.vcf.gz"]
when = "config.intervals_enabled && config.variant_tool == 'gatk' && wildcard.input_type != 'gvcf' && (!file_exists(\"results/reference/.long_contig.flag\") || config.long_contig_mode == false)"
output = [
    "results/gvcfs/{sample}.g.vcf.gz",
    "results/gvcfs/{sample}.g.vcf.gz.tbi",
]
depends_on = ["create_gvcf_intervals"]
log = "logs/concat_interval_gvcfs/{sample}.txt"
shell = """
bcftools concat -D -a -Ou {input} 2> {log} \
    | bcftools sort -T . -Oz -o {output[0]} 2>> {log}
bcftools index -t {output[0]} 2>> {log}
"""
tags = ["variant-calling"]

[rules.resources]
threads = 1

[rules.environment]
conda = "envs/bcftools.yaml"

[[rules]]
name = "concat_interval_gvcfs_long"
description = "Merge per-interval gVCFs into the per-sample gVCF (interval mode, long-contig CSI; plain .vcf + GATK .idx in the work dir, upstream gatk_intervals.smk convention)"
input = ["results/interval_gvcfs/{sample}/*.g.vcf"]
output = [
    "results/gvcfs/work/{sample}.g.vcf",
    "results/gvcfs/work/{sample}.g.vcf.idx",
]
when = "config.intervals_enabled && config.variant_tool == 'gatk' && {meta.input_type} != 'gvcf' && file_exists(\"results/reference/.long_contig.flag\") && config.long_contig_mode != false"
depends_on = ["create_gvcf_intervals", "resolve_long_contig_mode"]
log = "logs/concat_interval_gvcfs_long/{sample}.txt"
shell = """
mkdir -p results/gvcfs/work
for gvcf in {input}; do
    bgzip -c "$gvcf" > "results/gvcfs/work/$(basename "$gvcf").gz"
    bcftools index -f "results/gvcfs/work/$(basename "$gvcf").gz"
done
bcftools concat -D -a -Ou results/gvcfs/work/*.g.vcf.gz 2> {log} \
    | bcftools sort -T . -o {output[0]} 2>> {log}
gatk IndexFeatureFile -I {output[0]} 2>> {log}
"""
tags = ["variant-calling"]

[rules.resources]
threads = 1

[rules.environment]
conda = "envs/gatk.yaml"

[[rules]]
name = "create_db_intervals"
description = "Split the filtered interval list into DB scatter shards (joint genotyping, interval mode, output_pattern producer)"
input = [
    "results/intervals/filtered.interval_list",
    "results/reference/{config.reference_name}.fa.gz",
    "results/reference/{config.reference_name}.fa.gz.fai",
    "results/reference/{config.reference_name}.dict",
]
when = "config.intervals_enabled && config.joint_genotyping_enabled && config.variant_tool == 'gatk'"
output_pattern = "results/intervals/db/{db_interval}-scattered.interval_list"
log = "logs/create_db_intervals.txt"
shell = """
: > {log}
mkdir -p results/intervals/db
raw_dir=$(mktemp -d results/intervals/db/gatk_split_raw.XXXXXX)
trap 'rm -rf "$raw_dir";' EXIT
NUM_SAMPLES=$(echo "{config.samples_list}" | tr ',' '\n' | grep -c . || true)
DB_SCATTER=$(awk -v n="$NUM_SAMPLES" -v f="{config.intervals_db_scatter_factor}" -v g="{config.intervals_scatter_count}" 'BEGIN { c = int(f * n * g); print (c < 1 ? 1 : c) }')
gatk SplitIntervals \
    --java-options '-Xmx7000m' \
    -R {input[1]} \
    -L {input[0]} \
    -O "$raw_dir" \
    --scatter-count "$DB_SCATTER" \
    --subdivision-mode INTERVAL_SUBDIVISION \
    --interval-merging-rule OVERLAPPING_ONLY \
    >> {log} 2>&1
python scripts/interval_list_tools.py split-db \
    --input-dir "$raw_dir" \
    --output-dir results/intervals/db \
    --fof results/intervals/db/intervals.txt \
    --max-intervals-per-shard {config.intervals_db_max_intervals_per_shard} \
    --max-contigs-per-shard {config.intervals_db_max_contigs_per_shard} \
    --merge-contigs-threshold 50 \
    >> {log} 2>&1
"""
tags = ["variant-calling"]

[rules.resources]
threads = 1

[rules.environment]
conda = "envs/gatk.yaml"

[[rules]]
name = "gatk_genomics_db_import_interval"
description = "Import all sample gVCFs into one per-shard GenomicsDB workspace (interval mode)"
input = [
    "results/genomics_db/mapfile.txt",
    "results/reference/{config.reference_name}.fa.gz",
    "results/reference/{config.reference_name}.fa.gz.fai",
    "results/reference/{config.reference_name}.dict",
    "results/intervals/db/{db_interval}-scattered.interval_list",
]
expand_inputs = [
    { pattern = "results/gvcfs/{sample}.g.vcf.gz", variables = { sample = "config.samples_list" } },
    { pattern = "results/gvcfs/{sample}.g.vcf.gz.tbi", variables = { sample = "config.samples_list" } },
]
when = "config.intervals_enabled && config.joint_genotyping_enabled && config.variant_tool == 'gatk' && (!file_exists(\"results/reference/.long_contig.flag\") || config.long_contig_mode == false)"
output = [
    "results/gatk_genomics_db/L{db_interval}.tar",
]
temp_output = ["results/gatk_genomics_db/L{db_interval}.tar"]
log = "logs/gatk_genomics_db_import_interval/{db_interval}.txt"
shell = """
: > {log}
export TILEDB_DISABLE_FILE_LOCKING=1
DB_DIR="results/gatk_genomics_db/L{db_interval}"
rm -rf "$DB_DIR"
trap 'rm -rf "$DB_DIR";' EXIT
MERGE_CONTIGS_ARG=$(python scripts/interval_list_tools.py genomicsdb-merge-contigs-arg \\
    --input {input[4]} \\
    --threshold 50 2>> {log})
gatk GenomicsDBImport \
    --java-options '-Xmx7000m' \
    --genomicsdb-shared-posixfs-optimizations true \
    --batch-size 25 \
    --genomicsdb-workspace-path "$DB_DIR" \
    --merge-input-intervals $MERGE_CONTIGS_ARG \
    --reader-threads {threads} \
    -L {input[4]} \
    --sample-name-map {input[0]} \
    >> {log} 2>&1
tar -cf {output[0]} "$DB_DIR" >> {log} 2>&1
"""
tags = ["variant-calling"]

[rules.resources]
threads = 1

[rules.environment]
conda = "envs/gatk.yaml"

[[rules]]
name = "gatk_genomics_db_import_interval_long"
description = "Import all sample gVCFs into one per-shard GenomicsDB workspace (interval mode, long-contig CSI; GATK reads the plain work .vcf + .idx)"
input = [
    "results/genomics_db/mapfile.txt",
    "results/reference/{config.reference_name}.fa.gz",
    "results/reference/{config.reference_name}.fa.gz.fai",
    "results/reference/{config.reference_name}.dict",
    "results/intervals/db/{db_interval}-scattered.interval_list",
]
expand_inputs = [
    { pattern = "results/gvcfs/work/{sample}.g.vcf", variables = { sample = "config.samples_list" } },
    { pattern = "results/gvcfs/work/{sample}.g.vcf.idx", variables = { sample = "config.samples_list" } },
    { pattern = "results/gvcfs/{sample}.g.vcf.gz", variables = { sample = "config.samples_list" } },
    { pattern = "results/gvcfs/{sample}.g.vcf.gz.csi", variables = { sample = "config.samples_list" } },
]
when = "config.intervals_enabled && config.joint_genotyping_enabled && config.variant_tool == 'gatk' && file_exists(\"results/reference/.long_contig.flag\") && config.long_contig_mode != false"
output = [
    "results/gatk_genomics_db/L{db_interval}.tar",
]
temp_output = ["results/gatk_genomics_db/L{db_interval}.tar"]
depends_on = ["resolve_long_contig_mode"]
log = "logs/gatk_genomics_db_import_interval_long/{db_interval}.txt"
shell = """
: > {log}
export TILEDB_DISABLE_FILE_LOCKING=1
DB_DIR="results/gatk_genomics_db/L{db_interval}"
rm -rf "$DB_DIR"
trap 'rm -rf "$DB_DIR";' EXIT
MERGE_CONTIGS_ARG=$(python scripts/interval_list_tools.py genomicsdb-merge-contigs-arg \\
    --input {input[4]} \\
    --threshold 50 2>> {log})
gatk GenomicsDBImport \
    --java-options '-Xmx7000m' \
    --genomicsdb-shared-posixfs-optimizations true \
    --batch-size 25 \
    --genomicsdb-workspace-path "$DB_DIR" \
    --merge-input-intervals $MERGE_CONTIGS_ARG \
    --reader-threads {threads} \
    -L {input[4]} \
    --sample-name-map {input[0]} \
    >> {log} 2>&1
tar -cf {output[0]} "$DB_DIR" >> {log} 2>&1
"""
tags = ["variant-calling"]

[rules.resources]
threads = 1

[rules.environment]
conda = "envs/gatk.yaml"

[[rules]]
name = "gatk_genotype_gvcfs_interval"
description = "Jointly genotype one DB shard (interval mode)"
input = [
    "results/gatk_genomics_db/L{db_interval}.tar",
    "results/reference/{config.reference_name}.fa.gz",
    "results/reference/{config.reference_name}.fa.gz.fai",
    "results/reference/{config.reference_name}.dict",
]
when = "config.intervals_enabled && config.joint_genotyping_enabled && config.variant_tool == 'gatk' && (!file_exists(\"results/reference/.long_contig.flag\") || config.long_contig_mode == false)"
output = [
    "results/vcfs/intervals/L{db_interval}.vcf.gz",
    "results/vcfs/intervals/L{db_interval}.vcf.gz.tbi",
]
log = "logs/gatk_genotype_gvcfs_interval/{db_interval}.txt"
shell = """
EXTRACT_DIR=$(mktemp -d .oxo-joint-gvcf.XXXXXX)
trap 'rm -rf "$EXTRACT_DIR";' EXIT
tar -xf {input[0]} -C "$EXTRACT_DIR"
gatk GenotypeGVCFs \
    --java-options '-Xmx7000m' \
    -R {input[1]} \
    --heterozygosity {config.gatk_het_prior} \
    --genomicsdb-shared-posixfs-optimizations true \
    -V gendb://"$EXTRACT_DIR/results/gatk_genomics_db/L{db_interval}" \
    -O {output[0]} \
    &> {log}
"""
tags = ["variant-calling"]

[rules.resources]
threads = 1

[rules.environment]
conda = "envs/gatk.yaml"

[[rules]]
name = "gatk_genotype_gvcfs_interval_long"
description = "Jointly genotype one DB shard (interval mode, long-contig CSI; plain .vcf output)"
input = [
    "results/gatk_genomics_db/L{db_interval}.tar",
    "results/reference/{config.reference_name}.fa.gz",
    "results/reference/{config.reference_name}.fa.gz.fai",
    "results/reference/{config.reference_name}.dict",
]
when = "config.intervals_enabled && config.joint_genotyping_enabled && config.variant_tool == 'gatk' && file_exists(\"results/reference/.long_contig.flag\") && config.long_contig_mode != false"
output = [
    "results/vcfs/intervals/L{db_interval}.vcf",
]
depends_on = ["resolve_long_contig_mode"]
log = "logs/gatk_genotype_gvcfs_interval_long/{db_interval}.txt"
shell = """
EXTRACT_DIR=$(mktemp -d .oxo-joint-gvcf.XXXXXX)
trap 'rm -rf "$EXTRACT_DIR";' EXIT
tar -xf {input[0]} -C "$EXTRACT_DIR"
gatk GenotypeGVCFs \
    --java-options '-Xmx7000m' \
    -R {input[1]} \
    --heterozygosity {config.gatk_het_prior} \
    --genomicsdb-shared-posixfs-optimizations true \
    -V gendb://"$EXTRACT_DIR/results/gatk_genomics_db/L{db_interval}" \
    -O {output[0]} \
    &> {log}
"""
tags = ["variant-calling"]

[rules.resources]
threads = 1

[rules.environment]
conda = "envs/gatk.yaml"

[[rules]]
name = "concat_interval_vcfs"
description = "Concatenate per-shard raw VCFs into the joint raw VCF (interval mode)"
input = ["results/vcfs/intervals/*.vcf.gz"]
when = "config.intervals_enabled && config.joint_genotyping_enabled && config.variant_tool == 'gatk' && (!file_exists(\"results/reference/.long_contig.flag\") || config.long_contig_mode == false)"
output = [
    "results/vcfs/raw.vcf.gz",
    "results/vcfs/raw.vcf.gz.tbi",
]
temp_output = [
    "results/vcfs/raw.vcf.gz",
    "results/vcfs/raw.vcf.gz.tbi",
]
depends_on = ["create_db_intervals"]
log = "logs/concat_interval_vcfs.txt"
shell = """
bcftools concat -D -a -Ou {input} 2> {log} \
    | bcftools sort -T . -Oz -o {output[0]} 2>> {log}
bcftools index -t {output[0]} 2>> {log}
"""
tags = ["variant-calling"]

[rules.resources]
threads = 1

[rules.environment]
conda = "envs/bcftools.yaml"

[[rules]]
name = "concat_interval_vcfs_long"
description = "Concatenate per-shard raw VCFs into the joint work VCF (interval mode, long-contig CSI; upstream gatk_genotype long chain — plain work/raw.vcf + .idx, compressed by compress_interval_raw_vcf)"
input = ["results/vcfs/intervals/*.vcf"]
when = "config.intervals_enabled && config.joint_genotyping_enabled && config.variant_tool == 'gatk' && file_exists(\"results/reference/.long_contig.flag\") && config.long_contig_mode != false"
output = [
    "results/vcfs/work/raw.vcf",
    "results/vcfs/work/raw.vcf.idx",
]
temp_output = [
    "results/vcfs/work/raw.vcf",
    "results/vcfs/work/raw.vcf.idx",
]
depends_on = ["create_db_intervals", "resolve_long_contig_mode"]
log = "logs/concat_interval_vcfs_long.txt"
shell = """
# GATK cannot read a CSI-only bgzip VCF, so the long-mode gather keeps the
# call set as a plain work VCF with a GATK .idx (upstream RAW_VCF_WORK);
# compress_interval_raw_vcf produces the .gz + CSI pair. Upstream stages with
# batched picard SortVcf (heap-capped MAX_RECORDS_IN_RAM); the port gathers in
# one bcftools pass (deviation: see README).
mkdir -p results/vcfs/work
for vcf in {input}; do
    bgzip -c "$vcf" > "results/vcfs/work/shard.$(basename "$vcf").gz"
    bcftools index -f "results/vcfs/work/shard.$(basename "$vcf").gz"
done
bcftools concat -D -a -Ou results/vcfs/work/shard.*.vcf.gz 2> {log} \
    | bcftools sort -T . -O v -o {output[0]} 2>> {log}
rm -f results/vcfs/work/shard.*.vcf.gz*
gatk IndexFeatureFile -I {output[0]} 2>> {log}
"""
tags = ["variant-calling"]

[rules.resources]
threads = 1

[rules.environment]
conda = "envs/gatk.yaml"

[[rules]]
name = "compress_interval_raw_vcf"
description = "Compress and CSI-index the interval-mode long-contig work VCF into the joint raw VCF (upstream compress_interval_raw_vcf)"
input = [
    "results/vcfs/work/raw.vcf",
    "results/vcfs/work/raw.vcf.idx",
]
when = "config.intervals_enabled && config.joint_genotyping_enabled && config.variant_tool == 'gatk' && file_exists(\"results/reference/.long_contig.flag\") && config.long_contig_mode != false"
output = [
    "results/vcfs/raw.vcf.gz",
    "results/vcfs/raw.vcf.gz.csi",
]
temp_output = [
    "results/vcfs/raw.vcf.gz",
    "results/vcfs/raw.vcf.gz.csi",
]
depends_on = ["resolve_long_contig_mode"]
log = "logs/compress_interval_raw_vcf.txt"
shell = """
bcftools view -Oz -o {output[0]} {input[0]} 2> {log}
bcftools index -f -c {output[0]} 2>> {log}
"""
tags = ["variant-calling"]

[rules.resources]
threads = 1

[rules.environment]
conda = "envs/bcftools.yaml"

# ---------------------------------------------------------------------------
# Variant calling (per-sample gVCF)
# ---------------------------------------------------------------------------

[[rules]]
name = "gatk_haplotypecaller"
description = "Per-sample variant calling to gVCF with GATK HaplotypeCaller (no-markdup BAM)"
input = [
    "results/bams/merged/{sample}.bam",
    "results/bams/merged/{sample}.bam.csi",
    "results/reference/{config.reference_name}.fa.gz",
    "results/reference/{config.reference_name}.fa.gz.fai",
    "results/reference/{config.reference_name}.dict",
]
when = "config.variant_tool == 'gatk' && (!config.mark_duplicates || {meta.mark_duplicates} == 'false') && {meta.mark_duplicates} != 'true' && !config.intervals_enabled && (wildcard.input_type == 'fastq' || wildcard.input_type == 'srr') && (!file_exists(\"results/reference/.long_contig.flag\") || config.long_contig_mode == false)"
output = [
    "results/gvcfs/{sample}.g.vcf.gz",
    "results/gvcfs/{sample}.g.vcf.gz.tbi",
]
log = "logs/gatk_haplotypecaller/{sample}.txt"
shell = """
# Upstream HC_MIN_PRUNING/HC_MIN_DANGLING (v2.3.0): low-coverage cohorts call
# at 1/1, otherwise GATK's defaults 2/4.
HC_PRUNE=1
HC_DANGLING=1
if [ "{config.expected_coverage}" != "low" ]; then HC_PRUNE=2; HC_DANGLING=4; fi
gatk HaplotypeCaller \
    --java-options '-Xmx7000m' \
    -R {input[2]} \
    -I {input[0]} \
    --read-index {input[1]} \
    -O {output[0]} \
    -ploidy {config.ploidy} \
    --native-pair-hmm-threads {threads} \
    --emit-ref-confidence GVCF \
    --min-pruning "$HC_PRUNE" \
    --min-dangling-branch-length "$HC_DANGLING"
"""
tags = ["variant-calling"]

[rules.resources]
threads = 1

[rules.environment]
conda = "envs/gatk.yaml"

[[rules]]
name = "gatk_haplotypecaller_markdup"
description = "Per-sample variant calling to gVCF with GATK HaplotypeCaller (duplicate-marked BAM)"
input = [
    "results/bams/markdup/{sample}.bam",
    "results/bams/markdup/{sample}.bam.csi",
