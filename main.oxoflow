when = "config.intervals_enabled && config.variant_tool == 'gatk' && (config.mark_duplicates || {meta.mark_duplicates} == 'true') && {meta.mark_duplicates} != 'false' && (wildcard.input_type == 'fastq' || wildcard.input_type == 'srr') && file_exists(\"results/reference/.long_contig.flag\") && config.long_contig_mode != false"
