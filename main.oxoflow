[rules.environment]
conda = "envs/bcftools.yaml"

# ---------------------------------------------------------------------------
# Joint genotyping (GATK: GenomicsDB -> GenotypeGVCFs; DeepVariant: GLnexus)
# ---------------------------------------------------------------------------

[[rules]]
name = "create_db_mapfile"
description = "Write the GenomicsDB sample-name map from per-sample gVCF paths"
input = []
expand_inputs = [
    { pattern = "results/gvcfs/{sample}.g.vcf.gz", variables = { sample = "config.samples_list" } },
]
when = "config.joint_genotyping_enabled && config.variant_tool == 'gatk' && (!file_exists(\"results/reference/.long_contig.flag\") || config.long_contig_mode == false)"
output = ["results/genomics_db/mapfile.txt"]
log = "logs/create_db_mapfile.txt"
script = "scripts/write_joint_gvcf_mapfile.py {output[0]} {input}"
tags = ["variant-calling"]

[[rules]]
name = "create_db_mapfile_long"
description = "Write the GenomicsDB sample-name map from per-sample gVCFs (long-contig CSI; points GATK at the plain work .vcf files)"
input = []
expand_inputs = [
    { pattern = "results/gvcfs/work/{sample}.g.vcf", variables = { sample = "config.samples_list" } },
    { pattern = "results/gvcfs/{sample}.g.vcf.gz", variables = { sample = "config.samples_list" } },
    { pattern = "results/gvcfs/{sample}.g.vcf.gz.csi", variables = { sample = "config.samples_list" } },
]
when = "config.joint_genotyping_enabled && config.variant_tool == 'gatk' && file_exists(\"results/reference/.long_contig.flag\") && config.long_contig_mode != false"
output = ["results/genomics_db/mapfile.txt"]
depends_on = ["resolve_long_contig_mode"]
log = "logs/create_db_mapfile_long.txt"
script = "scripts/write_joint_gvcf_mapfile.py {output[0]} {input}"
tags = ["variant-calling"]

[[rules]]
name = "joint_genomics_db_import"
description = "Import all sample gVCFs into a GenomicsDB workspace (GATK)"
input = [
    "results/genomics_db/mapfile.txt",
    "results/reference/{config.reference_name}.fa.gz",
    "results/reference/{config.reference_name}.fa.gz.fai",
    "results/reference/{config.reference_name}.dict",
]
expand_inputs = [
    { pattern = "results/gvcfs/{sample}.g.vcf.gz", variables = { sample = "config.samples_list" } },
    { pattern = "results/gvcfs/{sample}.g.vcf.gz.tbi", variables = { sample = "config.samples_list" } },
]
when = "config.joint_genotyping_enabled && config.variant_tool == 'gatk' && !config.intervals_enabled && (!file_exists(\"results/reference/.long_contig.flag\") || config.long_contig_mode == false)"
output = [
    "results/gatk_genomics_db",
    "results/gatk_genomics_db.tar",
]
temp_output = ["results/gatk_genomics_db"]
log = "logs/joint_genomics_db_import.txt"
shell = """
: > {log}
export TILEDB_DISABLE_FILE_LOCKING=1
# Upstream passes the .fai as -L, which GATK 4.x rejects ("does not
# contain Features"). v2.3.0 sends one whole-contig interval per contig as
# BED: GATK's -L reads interval files (.list, .intervals, .interval_list,
# .bed) and rejects a .fai, and BED, unlike a .list of names, cannot mistake
# a contig name containing ':' for chr:start-end. Whole contigs are also what
# --merge-contigs-into-num-partitions requires.
MERGE_CONTIGS_ARG=$(python scripts/interval_list_tools.py genomicsdb-merge-contigs-arg \\
    --input {input[2]} \\
    --threshold 50 2>> {log})
WORK=$(mktemp -d "results/gatk_genomics_db_import_work_XXXXXX")
trap 'rm -rf "$WORK";' EXIT
awk 'BEGIN {OFS = "\\t"} {print $1, 0, $2}' {input[2]} > "$WORK/whole_genome.bed"
gatk GenomicsDBImport \
    --java-options '-Xmx7000m' \
    --genomicsdb-shared-posixfs-optimizations true \
    --batch-size 25 \
    --genomicsdb-workspace-path {output[0]} \
    --merge-input-intervals $MERGE_CONTIGS_ARG \
    --reader-threads {threads} \
    -L "$WORK/whole_genome.bed" \
    --sample-name-map {input[0]} \
    >> {log} 2>&1
tar -cf {output[1]} {output[0]} >> {log} 2>&1
"""
tags = ["variant-calling"]

[rules.resources]
threads = 1

[rules.environment]
conda = "envs/gatk.yaml"

[[rules]]
name = "joint_genomics_db_import_long"
description = "Import all sample gVCFs into a GenomicsDB workspace (long-contig CSI; GATK reads the plain work .vcf + .idx, archives ordered in as inputs)"
input = [
    "results/genomics_db/mapfile.txt",
    "results/reference/{config.reference_name}.fa.gz",
    "results/reference/{config.reference_name}.fa.gz.fai",
    "results/reference/{config.reference_name}.dict",
]
expand_inputs = [
    { pattern = "results/gvcfs/work/{sample}.g.vcf", variables = { sample = "config.samples_list" } },
    { pattern = "results/gvcfs/work/{sample}.g.vcf.idx", variables = { sample = "config.samples_list" } },
    { pattern = "results/gvcfs/{sample}.g.vcf.gz", variables = { sample = "config.samples_list" } },
    { pattern = "results/gvcfs/{sample}.g.vcf.gz.csi", variables = { sample = "config.samples_list" } },
]
when = "config.joint_genotyping_enabled && config.variant_tool == 'gatk' && !config.intervals_enabled && file_exists(\"results/reference/.long_contig.flag\") && config.long_contig_mode != false"
output = [
    "results/gatk_genomics_db",
    "results/gatk_genomics_db.tar",
]
temp_output = ["results/gatk_genomics_db"]
depends_on = ["resolve_long_contig_mode"]
log = "logs/joint_genomics_db_import_long.txt"
shell = """
: > {log}
export TILEDB_DISABLE_FILE_LOCKING=1
MERGE_CONTIGS_ARG=$(python scripts/interval_list_tools.py genomicsdb-merge-contigs-arg \\
    --input {input[2]} \\
    --threshold 50 2>> {log})
WORK=$(mktemp -d "results/gatk_genomics_db_import_work_XXXXXX")
trap 'rm -rf "$WORK";' EXIT
awk 'BEGIN {OFS = "\\t"} {print $1, 0, $2}' {input[2]} > "$WORK/whole_genome.bed"
gatk GenomicsDBImport \
    --java-options '-Xmx7000m' \
    --genomicsdb-shared-posixfs-optimizations true \
    --batch-size 25 \
    --genomicsdb-workspace-path {output[0]} \
    --merge-input-intervals $MERGE_CONTIGS_ARG \
    --reader-threads {threads} \
    -L "$WORK/whole_genome.bed" \
    --sample-name-map {input[0]} \
    >> {log} 2>&1
tar -cf {output[1]} {output[0]} >> {log} 2>&1
"""
tags = ["variant-calling"]

[rules.resources]
threads = 1

[rules.environment]
conda = "envs/gatk.yaml"

[[rules]]
name = "joint_genotype_gvcfs"
description = "Jointly genotype the cohort from the GenomicsDB workspace (GATK)"
input = [
    "results/gatk_genomics_db.tar",
    "results/reference/{config.reference_name}.fa.gz",
    "results/reference/{config.reference_name}.fa.gz.fai",
    "results/reference/{config.reference_name}.dict",
]
when = "config.joint_genotyping_enabled && config.variant_tool == 'gatk' && !config.intervals_enabled && (!file_exists(\"results/reference/.long_contig.flag\") || config.long_contig_mode == false)"
output = [
    "results/vcfs/raw.vcf.gz",
    "results/vcfs/raw.vcf.gz.tbi",
]
temp_output = [
    "results/vcfs/raw.vcf.gz",
    "results/vcfs/raw.vcf.gz.tbi",
]
log = "logs/joint_genotype_gvcfs.txt"
shell = """
EXTRACT_DIR=$(mktemp -d .oxo-joint-gvcf.XXXXXX)
trap 'rm -rf "$EXTRACT_DIR";' EXIT
tar -xf {input[0]} -C "$EXTRACT_DIR"
gatk GenotypeGVCFs \
    --java-options '-Xmx7000m' \
    -R {input[1]} \
    --heterozygosity {config.gatk_het_prior} \
    --genomicsdb-shared-posixfs-optimizations true \
    -V gendb://"$EXTRACT_DIR/results/gatk_genomics_db" \
    -O {output[0]} \
    &> {log}
"""
tags = ["variant-calling"]

[rules.resources]
threads = 1

[rules.environment]
conda = "envs/gatk.yaml"

[[rules]]
name = "joint_genotype_gvcfs_long"
description = "Jointly genotype the cohort from the GenomicsDB workspace (long-contig CSI; plain work/raw.vcf + .idx, compressed by compress_joint_raw_vcf)"
input = [
    "results/gatk_genomics_db.tar",
