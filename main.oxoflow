input = ["results/deepvariant/{sample}.g.vcf"]
when = "config.variant_tool == 'deepvariant' && file_exists(\"results/reference/.long_contig.flag\") && config.long_contig_mode != false"
output = [
    "results/gvcfs/{sample}.g.vcf.gz",
