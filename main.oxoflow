# at 1/1, otherwise GATK's defaults 2/4.
HC_PRUNE=1
HC_DANGLING=1
if [ "{config.expected_coverage}" != "low" ]; then HC_PRUNE=2; HC_DANGLING=4; fi
gatk HaplotypeCaller \
    --java-options '-Xmx7000m' \
    -R {input[2]} \
